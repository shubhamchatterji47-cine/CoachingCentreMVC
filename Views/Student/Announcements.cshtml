@model List<CoachingMVC.ViewModels.Shared.AnnouncementViewModel>
@{
    ViewData["Title"] = "Announcements";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">📢 Announcements</h4>
        <p class="text-muted small mb-0">
            Latest updates from your coaching centre
        </p>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-3">
        @foreach (var a in Model)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm"
                     style="border-radius:16px;
                            border-left:4px solid #2563eb !important">
                    <div class="card-body">
                        <div class="d-flex justify-content-between 
                                    align-items-start flex-wrap gap-2">
                            <div>
                                <h6 class="fw-bold mb-1">@a.Title</h6>
                                <p class="text-muted small mb-2">
                                    @a.Content
                                </p>
                                <span class="small text-muted">
                                    📅 @a.CreatedAt.ToString("dd MMM yyyy")
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(a.TargetRole))
                            {
                                <span class="badge bg-primary">
                                    @a.TargetRole
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm text-center py-5"
         style="border-radius:16px">
        <div style="font-size:4rem">📢</div>
        <h5 class="fw-bold mt-3">No Announcements</h5>
        <p class="text-muted">
            No announcements available right now.
        </p>
    </div>
}