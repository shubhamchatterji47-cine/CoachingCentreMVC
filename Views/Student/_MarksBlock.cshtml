@model List<CoachingMVC.ViewModels.Student.MarkViewModel>

@functions {
    static string GradeColor(string grade) => grade switch
    {
        "A+" or "A" => "success",
        "B+" or "B" => "primary",
        "C"         => "warning",
        _           => "danger"
    };
}

<!-- ===== TABLE: shown on md screens and up ===== -->
<div class="card d-none d-md-block">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>Marks</th>
                        <th>Max</th>
                        <th style="min-width:140px">%</th>
                        <th>Grade</th>
                        <th>Date</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        var bc = GradeColor(m.Grade);
                        <tr>
                            <td class="fw-bold">@m.SubjectName</td>
                            <td class="fw-semibold">@m.ObtainedMarks</td>
                            <td class="text-muted small">@m.MaxMarks</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:6px">
                                        <div class="progress-bar bg-@bc"
                                             style="width:@((int)m.Percentage)%"></div>
                                    </div>
                                    <span class="small">@m.Percentage.ToString("F1")%</span>
                                </div>
                            </td>
                            <td><span class="badge rounded-pill bg-@bc">@m.Grade</span></td>
                            <td class="small text-muted">@m.ExamDate.ToString("dd MMM yyyy")</td>
                            <td class="small text-muted">@(m.Remarks ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ===== CARDS: shown only on small screens ===== -->
<div class="d-md-none">
    @foreach (var m in Model)
    {
        var bc = GradeColor(m.Grade);
        <div class="card mb-2 shadow-sm">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="fw-bold">@m.SubjectName</div>
                    <span class="badge rounded-pill bg-@bc fs-6">@m.Grade</span>
                </div>

                <div class="d-flex justify-content-between small mb-2">
                    <span>
                        <span class="fw-semibold">@m.ObtainedMarks</span>
                        <span class="text-muted">/ @m.MaxMarks</span>
                    </span>
                    <span class="text-muted">@m.ExamDate.ToString("dd MMM yyyy")</span>
                </div>

                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="progress flex-grow-1" style="height:6px">
                        <div class="progress-bar bg-@bc"
                             style="width:@((int)m.Percentage)%"></div>
                    </div>
                    <span class="small fw-semibold">@m.Percentage.ToString("F1")%</span>
                </div>

                @if (!string.IsNullOrEmpty(m.Remarks))
                {
                    <div class="small text-muted border-top pt-2">
                        💬 @m.Remarks
                    </div>
                }
            </div>
        </div>
    }
</div>
