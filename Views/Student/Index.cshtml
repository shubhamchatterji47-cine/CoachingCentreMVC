@model CoachingMVC.ViewModels.Student.StudentPerformanceViewModel
@using CoachingMVC.ViewModels.Student
@{
    ViewData["Title"] = "My Dashboard";
    var profile = ViewBag.Profile as StudentViewModel;

    // FIX: compute trend color in C# — avoids nested quotes in HTML attribute
    var trendColor = Model?.PerformanceTrend == "Improving" ? "#198754"
                   : Model?.PerformanceTrend == "Declining" ? "#dc3545"
                   : "#6c757d";
    var trendIcon = Model?.PerformanceTrend == "Improving" ? "📈"
                   : Model?.PerformanceTrend == "Declining" ? "📉"
                   : "➡️";
}

<h4 class="fw-bold mb-4">📊 My Dashboard</h4>

@if (profile != null)
{
    <div class="card shadow-sm mb-4 border-0"
         style="background:linear-gradient(135deg,#2563eb,#1e40af);color:white">

        <div class="card-body d-flex align-items-center gap-3 flex-wrap">

            <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center fw-bold"
                 style="width:60px;height:60px;font-size:1.5rem;">
                @profile.FullName[0]
            </div>

            <div>
                <h5 class="mb-0 fw-bold">@profile.FullName</h5>

                <div class="small text-white-50">
                    @profile.Email · Roll: @(profile.RollNumber ?? "N/A")
                </div>

                <div class="small mt-1">
                    <span class="badge bg-light text-dark me-1">
                        @profile.ClassName
                    </span>

                    <span class="badge bg-warning text-dark">
                        @profile.CourseName
                    </span>
                </div>
            </div>

            <div class="ms-auto d-flex gap-2 flex-wrap">
                <a asp-action="Marks" class="btn btn-light btn-sm">
                    📝 Marks
                </a>

                <a asp-action="Performance" class="btn btn-outline-light btn-sm">
                    📈 Report
                </a>

                <a asp-action="Profile" class="btn btn-outline-light btn-sm">
                    👤 Profile
                </a>
            </div>

        </div>
    </div>
}
@if (Model != null)
{
    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-sm-3">
            <div class="card border-0 bg-primary text-white text-center shadow-sm">
                <div class="card-body py-3">
                    <div class="fs-2 fw-bold">@Model.OverallPercentage.ToString("F1")%</div>
                    <div class="small opacity-75">Overall %</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-sm-3">
            <div class="card border-0 bg-success text-white text-center shadow-sm">
                <div class="card-body py-3">
                    <div class="fs-2 fw-bold">@Model.OverallGrade</div>
                    <div class="small opacity-75">Grade</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-sm-3">
            <div class="card border-0 bg-info text-white text-center shadow-sm">
                <div class="card-body py-3">
                    <div class="fs-2 fw-bold">@Model.AttendancePercentage.ToString("F0")%</div>
                    <div class="small opacity-75">Attendance</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-sm-3">
            <!-- FIX: use C# variable trendColor instead of inline ternary -->
            <div class="card border-0 shadow-sm text-center" style="background:@trendColor;color:white">
                <div class="card-body py-3">
                    <div class="fs-2">@trendIcon</div>
                    <div class="small opacity-75">@Model.PerformanceTrend</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Chart.js Bar Chart -->
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    <span>📊 Subject Performance</span>
                    <small class="text-muted">Average %</small>
                </div>
                <div class="card-body">
                    @if (Model.SubjectPerformances.Any())
                    {
                        <canvas id="perfChart" height="200"></canvas>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3 mb-0">No marks recorded yet.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Tips + Subject Breakdown -->
        <div class="col-md-5">
            @if (Model.ImprovementTips.Any())
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-header fw-semibold">💡 Improvement Tips</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var tip in Model.ImprovementTips.Take(5))
                        {
                            <li class="list-group-item small">@tip</li>
                        }
                    </ul>
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Subject Breakdown</div>
                <div class="card-body p-0">
                    @foreach (var sp in Model.SubjectPerformances)
                    {
                        var barColor = sp.AveragePercentage >= 75 ? "success"
                        : sp.AveragePercentage >= 50 ? "warning"
                        : "danger";
                        <div class="px-3 py-2 border-bottom">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="small fw-semibold">@sp.SubjectName</span>
                                <span class="badge bg-@barColor">@sp.Grade</span>
                            </div>
                            <div class="progress" style="height:5px">
                                <div class="progress-bar bg-@barColor"
                                     style="width:@((int)sp.AveragePercentage)%"></div>
                            </div>
                            <div class="text-muted" style="font-size:11px">
                                @sp.AveragePercentage.ToString("F1")%
                            </div>
                        </div>
                    }
                    @if (!Model.SubjectPerformances.Any())
                    {
                        <p class="text-muted p-3 mb-0 small">No data yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        No performance data available yet. Marks will appear here once your teacher records them.
    </div>
}

@section Scripts {
    @if (Model != null && Model.SubjectPerformances.Any())
    {
        <script>
            const labels = [@Html.Raw(string.Join(",", Model.SubjectPerformances.Select(s => $"'{s.SubjectName}'")))];
            const data   = [@Html.Raw(string.Join(",", Model.SubjectPerformances.Select(s => s.AveragePercentage.ToString("F1"))))];
            const colors = data.map(v => v >= 75 ? '#198754' : v >= 50 ? '#ffc107' : '#dc3545');

            new Chart(document.getElementById('perfChart'), {
                type: 'bar',
                data: {
                    labels,
                    datasets: [{
                        label: 'Average %',
                        data,
                        backgroundColor: colors,
                        borderRadius: 6,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: { callback: v => v + '%' },
                            grid: { color: 'rgba(0,0,0,0.05)' }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
        </script>
    }
}
