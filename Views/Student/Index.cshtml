@model CoachingMVC.ViewModels.Student.StudentPerformanceViewModel
@using CoachingMVC.ViewModels.Student
@{
    ViewData["Title"] = "My Dashboard";
    var profile = ViewBag.Profile as StudentViewModel;
    var trendColor = Model?.PerformanceTrend == "Improving" ? "#198754" :
                   Model?.PerformanceTrend == "Declining" ? "#dc3545" : "#6c757d";
    var trendIcon = Model?.PerformanceTrend == "Improving" ? "📈" :
                   Model?.PerformanceTrend == "Declining" ? "📉" : "➡️";
}

<h4 class="fw-bold mb-4" style="color:#0f172a">📊 My Dashboard</h4>

@if (profile != null)
{
    <div class="card shadow-sm mb-4 border-0 overflow-hidden" style="border-radius:18px;background:linear-gradient(135deg,#2563eb,#1e40af);color:white">
        <div class="card-body d-flex align-items-center gap-3 flex-wrap p-4">
            <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width:65px;height:65px;font-size:1.6rem;">
                @profile.FullName[0]
            </div>
            <div class="flex-grow-1 min-width-0">
                <h5 class="mb-1 fw-bold text-white">@profile.FullName</h5>
                <div class="small text-white-50 mb-2">@profile.Email · Roll: @(profile.RollNumber ?? "N/A")</div>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge rounded-pill" style="background:rgba(255,255,255,.2);color:white;font-size:.78rem">🏫 @profile.ClassName</span>
                    <span class="badge rounded-pill" style="background:rgba(255,255,255,.2);color:white;font-size:.78rem">📚 @profile.CourseName</span>
                </div>
            </div>
            <div class="d-flex gap-2 flex-shrink-0">
                <a asp-action="Marks" class="btn btn-light btn-sm rounded-pill px-3 fw-semibold" style="font-size:.82rem">📝 Marks</a>
                <a asp-action="Profile" class="btn btn-outline-light btn-sm rounded-pill px-3 border-1" style="font-size:.82rem">👤 Profile</a>
            </div>
        </div>
    </div>
}

@if (Model != null)
{
    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius:14px;overflow:hidden;border-left:4px solid #2563eb !important">
                <div class="card-body py-3 text-center">
                    <div class="fs-1 fw-bold text-primary">@Model.OverallPercentage.ToString("F1")%</div>
                    <div class="small text-muted fw-semibold">Overall Score</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius:14px;overflow:hidden;border-left:4px solid #10b981 !important">
                <div class="card-body py-3 text-center">
                    <div class="fs-1 fw-bold text-success">@Model.OverallGrade</div>
                    <div class="small text-muted fw-semibold">Grade</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius:14px;overflow:hidden;border-left:4px solid #06b6d4 !important">
                <div class="card-body py-3 text-center">
                    <div class="fs-1 fw-bold text-info">@Model.AttendancePercentage.ToString("F0")%</div>
                    <div class="small text-muted fw-semibold">Attendance</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius:14px;overflow:hidden;border-left:4px solid @trendColor !important">
                <div class="card-body py-3 text-center">
                    <div class="fs-1 fw-bold" style="color:@trendColor">@trendIcon</div>
                    <div class="small text-muted fw-semibold">@Model.PerformanceTrend</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Row -->
    <div class="row g-3">
        <!-- Chart Column -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0" style="border-radius:16px;overflow:hidden">
                <div class="card-header bg-white d-flex justify-content-between align-items-center" style="border-bottom:1px solid #eef2f7;padding:1rem 1.25rem;border-radius:16px 16px 0 0">
                    <span class="fw-bold">📊 Subject Performance</span>
                    <small class="text-muted">Average %</small>
                </div>
                <div class="card-body p-3">
                    @if (Model.SubjectPerformances.Any())
                    {
                        <canvas id="perfChart" height="220"></canvas>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">No marks recorded yet.</div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-5">
            @if (Model.ImprovementTips.Any())
            {
                <div class="card shadow-sm border-0 mb-3" style="border-radius:16px;overflow:hidden">
                    <div class="card-header bg-white fw-bold" style="border-bottom:1px solid #eef2f7;padding:1rem 1.25rem;border-radius:16px 16px 0 0">💡 Improvement Tips</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var tip in Model.ImprovementTips.Take(5))
                        {
                            <li class="list-group-item small border-light">@tip</li>
                        }
                    </ul>
                </div>
            }

            <div class="card shadow-sm border-0" style="border-radius:16px;overflow:hidden">
                <div class="card-header bg-white fw-bold" style="border-bottom:1px solid #eef2f7;padding:1rem 1.25rem;border-radius:16px 16px 0 0">Subject Breakdown</div>
                <div class="card-body p-0">
                    @if (Model.SubjectPerformances.Any())
                    {
                       @foreach (var sp in Model.SubjectPerformances)
{
    var barColor = sp.AveragePercentage >= 75 ? "success" :
                 sp.AveragePercentage >= 50 ? "warning" : "danger";

    var rowBg = sp.AveragePercentage < 50 ? "#fff5f5" : "white";

    <div class="px-3 py-2 border-bottom border-light" style="background:@rowBg">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small fw-bold" style="font-size:.85rem">@sp.SubjectName</span>
                                    <span class="badge rounded-pill bg-@barColor" style="font-size:.7rem;font-weight:700">@sp.Grade</span>
                                </div>
                                <div class="progress" style="height:6px;border-radius:10px;background:#e2e8f0">
                                    <div class="progress-bar bg-@barColor rounded-pill" style="width:@((int)sp.AveragePercentage)%"></div>
                                </div>
                                <div class="text-end mt-1" style="font-size:.72rem;color:#64748b">@sp.AveragePercentage.ToString("F1")%</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-3 text-muted small text-center">No subjects available.</div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info border-0" style="border-radius:12px;background:#eff6ff;color:#1e40af">
        No performance data available yet. Marks will appear here once your teacher records them.
    </div>
}

@section Scripts {
    @if (Model != null && Model.SubjectPerformances.Any())
    {
        <script>
            const labels = [@Html.Raw(string.Join(",", Model.SubjectPerformances.Select(s => $"'{s.SubjectName}'")))];
            const data = [@Html.Raw(string.Join(",", Model.SubjectPerformances.Select(s => s.AveragePercentage.ToString("F1"))))];
            const colors = data.map(v => v >= 75 ? '#10b981' : v >= 50 ? '#f59e0b' : '#ef4444');

            new Chart(document.getElementById('perfChart'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Avg %',
                        data: data,
                        backgroundColor: colors,
                        borderRadius: 8,
                        barThickness: 32
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: { callback: v => v + '%' },
                            grid: { color: 'rgba(0,0,0,.04)' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        </script>
    }
}