@model CoachingMVC.ViewModels.Student.StudentPerformanceViewModel
@{
    ViewData["Title"] = "My Performance";

    // Pre-compute — no == inside class/style attributes
    var trendColor = "warning";
    var trendIcon = "➡️";
    if (Model != null)
    {
        trendColor = Model.PerformanceTrend == "Improving" ? "info"
                   : Model.PerformanceTrend == "Declining" ? "danger"
                   : "warning";
        trendIcon = Model.PerformanceTrend == "Improving" ? "📈"
                   : Model.PerformanceTrend == "Declining" ? "📉"
                   : "➡️";
    }
}

<h4 class="fw-bold mb-4">📈 My Performance Report</h4>

@if (Model == null)
{
    <div class="alert alert-info">No performance data available yet.</div>
    return;
}

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card border-0 bg-primary text-white text-center shadow-sm">
            <div class="card-body py-3">
                <div class="fs-1 fw-bold">@Model.OverallPercentage.ToString("F1")%</div>
                <div>Overall Percentage</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-0 bg-success text-white text-center shadow-sm">
            <div class="card-body py-3">
                <div class="fs-1 fw-bold">@Model.OverallGrade</div>
                <div>Overall Grade</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card border-0 bg-@trendColor text-white text-center shadow-sm">
            <div class="card-body py-3">
                <div class="fs-1 fw-bold">@trendIcon</div>
                <div>@Model.PerformanceTrend</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        @foreach (var sp in Model.SubjectPerformances)
        {
            var bc = sp.Grade.StartsWith("A") ? "success"
            : sp.Grade.StartsWith("B") ? "primary"
            : sp.Grade == "C" ? "warning"
            : "danger";
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between">
                    <span class="fw-semibold">@sp.SubjectName</span>
                    <span class="badge bg-@bc fs-6">@sp.Grade</span>
                </div>
                <div class="card-body">
                    <div class="progress mb-2" style="height:10px">
                        <div class="progress-bar bg-primary" style="width:@((int)sp.AveragePercentage)%"></div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted mb-2">
                        <span>Average: @sp.AveragePercentage.ToString("F1")%</span>
                        <span>Max Marks: @sp.MaxMarks</span>
                    </div>
                    @if (sp.Marks.Any())
                    {
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-light">
                                <tr><th>Exam</th><th>Marks</th><th>%</th><th>Grade</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var m in sp.Marks)
                                {
                                    <tr>
                                        <td>@m.ExamType — @m.ExamDate.ToString("dd MMM")</td>
                                        <td>@m.ObtainedMarks / @m.MaxMarks</td>
                                        <td>@m.Percentage.ToString("F1")%</td>
                                        <td><span class="badge bg-secondary">@m.Grade</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
        @if (!Model.SubjectPerformances.Any())
        {
            <p class="text-muted text-center py-4">No subject data available.</p>
        }
    </div>
    <div class="col-md-4">
        @if (Model.ImprovementTips.Any())
        {
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">💡 Tips to Improve</div>
                <ul class="list-group list-group-flush">
                    @foreach (var tip in Model.ImprovementTips)
                    {
                        <li class="list-group-item small">✅ @tip</li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
