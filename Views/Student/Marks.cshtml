@model List<CoachingMVC.ViewModels.Student.MarkViewModel>
@{
    ViewData["Title"] = "My Marks";
    var examType  = ViewBag.ExamType?.ToString() ?? "All";
    var examTypes = new[] { "Test", "Midterm", "Final", "Assignment", "Quiz" };
    var grouped   = Model.GroupBy(m => m.ExamType).OrderBy(g => g.Key).ToList();
}

@* ===== Local helper to render grade colour ===== *@
@functions {
    static string GradeColor(string grade) => grade switch
    {
        "A+" or "A" => "success",
        "B+" or "B" => "primary",
        "C"         => "warning",
        _           => "danger"
    };
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">📝 My Marks</h4>
        <p class="text-muted small mb-0">View all your exam results</p>
    </div>
    <span class="badge bg-primary rounded-pill fs-6">@Model.Count Total</span>
</div>

<!-- Exam Type Filter (horizontally scrollable on mobile) -->
<div class="card mb-3">
    <div class="card-body py-2 px-3">
        <div class="d-flex gap-2 flex-nowrap flex-md-wrap align-items-center filter-scroll">
            <a asp-action="Marks"
               class="btn btn-sm flex-shrink-0 @(examType=="All"?"btn-dark":"btn-outline-secondary")">
                All
                <span class="badge @(examType=="All"?"bg-light text-dark":"bg-secondary") ms-1">
                    @Model.Count
                </span>
            </a>
            @foreach (var et in examTypes)
            {
                var count = Model.Count(m => m.ExamType == et);
                <a asp-action="Marks" asp-route-examType="@et"
                   class="btn btn-sm flex-shrink-0 @(et==examType?"btn-primary":"btn-outline-secondary")">
                    @et
                    @if (count > 0)
                    {
                        <span class="badge @(et==examType?"bg-light text-dark":"bg-primary") ms-1">
                            @count
                        </span>
                    }
                </a>
            }
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="empty-state text-center">
                <div class="empty-icon">📝</div>
                <div class="fw-semibold">No marks recorded yet</div>
                <div class="small">Marks will appear here once your teacher records them</div>
            </div>
        </div>
    </div>
}
else if (examType == "All")
{
    @foreach (var group in grouped)
    {
        var avg      = group.Average(m => m.Percentage);
        var avgColor = avg >= 75 ? "success" : avg >= 50 ? "warning" : "danger";
        var icon     = group.Key switch {
            "Midterm"    => "📋",
            "Final"      => "🎯",
            "Test"       => "✏️",
            "Assignment" => "📄",
            "Quiz"       => "⚡",
            _            => "📝"
        };

        <div class="mb-4">
            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                <h6 class="fw-bold mb-0">@icon @group.Key</h6>
                <span class="badge bg-secondary rounded-pill">@group.Count() marks</span>
                <span class="badge bg-@avgColor rounded-pill">Avg: @avg.ToString("F1")%</span>
            </div>

            @await Html.PartialAsync("_MarksBlock", group.OrderBy(m => m.SubjectName).ToList())
        </div>
    }
}
else
{
    @if (Model.Any())
    {
        @await Html.PartialAsync("_MarksBlock", Model.OrderBy(m => m.SubjectName).ToList())
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="empty-state text-center">
                    <div class="empty-icon">📝</div>
                    <div class="fw-semibold">No @examType marks yet</div>
                </div>
            </div>
        </div>
    }
}
