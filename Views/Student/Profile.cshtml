@model CoachingMVC.ViewModels.Student.StudentViewModel
@{
    ViewData["Title"] = "My Profile";
    var token    = Context.Session.GetString("Token") ?? "";
    var fullName = Context.Session.GetString("FullName") ?? "S";
}

<!-- Header -->
<div class="mb-4">
    <h4 class="fw-bold mb-1">👤 My Profile</h4>
    <p class="text-muted small mb-0">Your account information and settings</p>
</div>

<div class="row g-4">
    <!-- Profile Card -->
    <div class="col-md-5">
        <div class="card">
            <div class="card-body text-center py-5">
                <div class="rounded-circle text-white mx-auto d-flex align-items-center
                            justify-content-center fw-bold mb-3"
                     style="width:90px;height:90px;font-size:2.2rem;
                            background:linear-gradient(135deg,#2563eb,#1e40af)">
                    @fullName[0]
                </div>
                <h5 class="fw-bold mb-1">@fullName</h5>
                <span class="badge rounded-pill"
                      style="background:linear-gradient(135deg,#2563eb,#1e40af);
                             color:white;padding:.5rem 1rem;font-size:.8rem">
                    Student
                </span>
            </div>

            @if (Model != null)
            {
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-3">
                            <span class="text-muted small fw-semibold">📧 Email</span>
                            <span class="fw-bold small">@Model.Email</span>
                        </li>
                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-3">
                                <span class="text-muted small fw-semibold">📞 Phone</span>
                                <span class="fw-bold small">@Model.PhoneNumber</span>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(Model.RollNumber))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-3">
                                <span class="text-muted small fw-semibold">🎫 Roll No</span>
                                <span class="badge bg-primary rounded-pill">@Model.RollNumber</span>
                            </li>
                        }
                        <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-3">
                            <span class="text-muted small fw-semibold">🏫 Class</span>
                            <span class="fw-bold small">@Model.ClassName</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-3">
                            <span class="text-muted small fw-semibold">📚 Course</span>
                            <span class="badge rounded-pill"
                                  style="background:#e0f2fe;color:#0369a1">
                                @Model.CourseName
                            </span>
                        </li>
                        @if (!string.IsNullOrEmpty(Model.ParentName))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-3">
                                <span class="text-muted small fw-semibold">👨‍👩‍👦 Parent</span>
                                <span class="fw-bold small">@Model.ParentName</span>
                            </li>
                        }
                        <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-3">
                            <span class="text-muted small fw-semibold">📅 Enrolled</span>
                            <span class="fw-bold small">@Model.EnrollmentDate.ToString("dd MMM yyyy")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-3">
                            <span class="text-muted small fw-semibold">✅ Status</span>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success rounded-pill">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill">Inactive</span>
                            }
                        </li>
                    </ul>
                </div>
            }
        </div>
    </div>

    <!-- Right Column -->
    <div class="col-md-7">
        <!-- Change Password -->
        <div class="card mb-3">
            <div class="card-header">🔐 Change Password</div>
            <div class="card-body">
                <div id="pwMsg"></div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Current Password</label>
                        <input id="currentPassword" type="password" class="form-control"
                               placeholder="Enter current password" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">New Password</label>
                        <input id="newPassword" type="password" class="form-control"
                               placeholder="Minimum 6 characters" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Confirm New Password</label>
                        <input id="confirmPassword" type="password" class="form-control"
                               placeholder="Re-enter new password" />
                    </div>
                    <div class="col-12 pt-1">
                        <button id="changePwBtn" onclick="changePassword()"
                                class="btn btn-primary px-4">
                            🔐 Change Password
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Links -->
        <div class="card">
            <div class="card-header">⚡ Quick Actions</div>
            <div class="card-body d-grid gap-2">
                <a asp-controller="Student" asp-action="Index"
                   class="btn btn-outline-primary text-start">
                    📊 Go to Dashboard
                </a>
                <a asp-controller="Student" asp-action="Marks"
                   class="btn btn-outline-success text-start">
                    📝 View My Marks
                </a>
                <a asp-controller="Student" asp-action="Performance"
                   class="btn btn-outline-info text-start">
                    📈 View Performance Report
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const TOKEN = '@token';
        async function changePassword() {
            const current = document.getElementById('currentPassword').value.trim();
            const newPw   = document.getElementById('newPassword').value.trim();
            const confirm = document.getElementById('confirmPassword').value.trim();
            const msg     = document.getElementById('pwMsg');
            const btn     = document.getElementById('changePwBtn');
            msg.innerHTML = '';
            if (!current || !newPw || !confirm) {
                msg.innerHTML = '<div class="alert alert-warning border-0" style="border-radius:12px">Please fill in all fields.</div>';
                return;
            }
            if (newPw !== confirm) {
                msg.innerHTML = '<div class="alert alert-danger border-0" style="border-radius:12px">Passwords do not match.</div>';
                return;
            }
            if (newPw.length < 6) {
                msg.innerHTML = '<div class="alert alert-warning border-0" style="border-radius:12px">Minimum 6 characters required.</div>';
                return;
            }
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Changing...';
            try {
                const res = await fetch('/Account/ChangePassword', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ currentPassword: current, newPassword: newPw })
                });
                const data = await res.json();
                if (res.ok) {
                    msg.innerHTML = '<div class="alert alert-success border-0" style="border-radius:12px">✅ Password changed successfully!</div>';
                    document.getElementById('currentPassword').value = '';
                    document.getElementById('newPassword').value = '';
                    document.getElementById('confirmPassword').value = '';
                } else {
                    msg.innerHTML = `<div class="alert alert-danger border-0" style="border-radius:12px">${data.message ?? 'Failed.'}</div>`;
                }
            } catch {
                msg.innerHTML = '<div class="alert alert-danger border-0" style="border-radius:12px">Connection error.</div>';
            }
            btn.disabled = false;
            btn.innerHTML = '🔐 Change Password';
        }
    </script>
}