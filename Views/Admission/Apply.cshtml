@{
    ViewData["Title"] = "Apply for Admission";
    var courses = ViewBag.Courses as List<CoachingMVC.ViewModels.Shared.CourseViewModel> ?? new();
}

<style>
    :root {
        --nm-navy: #0a1628;
        --nm-blue: #1e40af;
        --nm-accent: #f59e0b;
        --nm-green: #10b981;
        --nm-light: #f0f4ff;
        --nm-text: #1e293b;
        --nm-muted: #64748b;
    }

    /* HERO */
    .admission-hero {
        background: var(--nm-navy);
        border-radius: 20px;
        padding: 3rem 2.5rem;
        color: white;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }

        .admission-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 70% 60% at 75% 40%, rgba(30,64,175,0.45) 0%, transparent 70%), radial-gradient(ellipse 50% 80% at 5% 90%, rgba(245,158,11,0.12) 0%, transparent 60%);
        }

    .admission-hero-grid {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
        background-size: 50px 50px;
    }

    .admission-hero .hero-inner {
        position: relative;
        z-index: 1;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: rgba(245,158,11,0.15);
        border: 1px solid rgba(245,158,11,0.35);
        color: #fbbf24;
        border-radius: 50px;
        padding: .35rem 1rem;
        font-size: .8rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .admission-hero h2 {
        font-family: 'Sora',sans-serif;
        font-weight: 800;
        font-size: clamp(1.6rem,3vw,2.4rem);
        letter-spacing: -1px;
        margin-bottom: .5rem;
    }

        .admission-hero h2 .accent {
            color: var(--nm-accent);
        }

    .admission-hero p {
        color: rgba(255,255,255,.65);
        margin-bottom: 0;
        font-size: 1.05rem;
    }

    /* STEPS */
    .step-badge {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,.2);
        color: rgba(255,255,255,.7);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: 'Sora',sans-serif;
        font-weight: 700;
        font-size: .9rem;
        flex-shrink: 0;
        transition: all .25s;
    }

        .step-badge.active {
            background: var(--nm-accent);
            border-color: var(--nm-accent);
            color: var(--nm-navy);
            box-shadow: 0 4px 16px rgba(245,158,11,.35);
        }

    .step-line {
        flex: 0 0 28px;
        height: 2px;
        background: rgba(255,255,255,.2);
    }

    .step-text {
        font-size: .85rem;
        color: rgba(255,255,255,.6);
    }

        .step-text.active {
            color: white;
            font-weight: 600;
        }

    /* SECTION LABEL */
    .section-label {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: var(--nm-light);
        color: var(--nm-blue);
        border-radius: 50px;
        padding: .3rem .9rem;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        margin-bottom: .75rem;
    }

    /* FORM SECTIONS */
    .form-section {
        background: #fff;
        border: 1.5px solid #e8edf5;
        border-radius: 16px;
        padding: 1.75rem;
        margin-bottom: 1.25rem;
        transition: all .25s;
    }

        .form-section:hover {
            border-color: #d6e0f0;
            box-shadow: 0 8px 30px rgba(30,64,175,.06);
        }

    .form-section-title {
        font-family: 'Sora',sans-serif;
        font-weight: 700;
        font-size: 1.05rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: .6rem;
        color: var(--nm-text);
        padding-bottom: .75rem;
        border-bottom: 1px solid #f1f5f9;
    }

        .form-section-title .fs-icon {
            font-size: 1.3rem;
        }

    .form-label {
        font-weight: 600;
        font-size: .85rem;
        color: var(--nm-text);
    }

    .admission-form .form-control,
    .admission-form .form-select {
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        padding: .6rem .85rem;
        font-size: .92rem;
        transition: all .2s;
    }

        .admission-form .form-control:focus,
        .admission-form .form-select:focus {
            border-color: var(--nm-blue);
            box-shadow: 0 0 0 3px rgba(30,64,175,.1);
        }

    /* BUTTONS */
    .nm-btn-primary {
        background: var(--nm-accent);
        color: var(--nm-navy) !important;
        border: none;
        font-family: 'Sora',sans-serif;
        font-weight: 700;
        font-size: .95rem;
        padding: .8rem 2.25rem;
        border-radius: 10px;
        transition: all .2s;
    }

        .nm-btn-primary:hover {
            background: #d97706;
            color: white !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(245,158,11,.35);
        }

        .nm-btn-primary:disabled {
            opacity: .7;
            transform: none;
        }

    .nm-btn-secondary {
        border: 1.5px solid #cbd5e1;
        color: var(--nm-text);
        font-weight: 600;
        font-size: .95rem;
        padding: .8rem 1.75rem;
        border-radius: 10px;
        background: white;
        transition: all .2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

        .nm-btn-secondary:hover {
            border-color: var(--nm-blue);
            color: var(--nm-blue);
            background: var(--nm-light);
        }

    /* SIDEBAR */
    .sidebar-card {
        border: 1.5px solid #e8edf5;
        border-radius: 16px;
        background: white;
        overflow: hidden;
    }

        .sidebar-card.highlight {
            background: linear-gradient(135deg, var(--nm-navy) 0%, var(--nm-blue) 100%);
            color: white;
            border: none;
        }

    .sidebar-title {
        font-family: 'Sora',sans-serif;
        font-weight: 700;
        font-size: 1rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .next-step-num {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.25);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Sora',sans-serif;
        font-weight: 700;
        font-size: .8rem;
        flex-shrink: 0;
    }

        .next-step-num.done {
            background: var(--nm-green);
            border-color: var(--nm-green);
        }

    .contact-row {
        font-size: .88rem;
        color: var(--nm-muted);
        margin-bottom: .6rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }
</style>

