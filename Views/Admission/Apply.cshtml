                                      placeholder="Any questions or details you'd like to share..."
                                      maxlength="1000">@ViewBag.Message</textarea>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 align-items-center flex-wrap mt-2 mb-4">
                    <button type="submit" class="nm-btn-primary" id="submitBtn">
                        📨 Submit Application
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="nm-btn-secondary">
                        ← Back to Home
                    </a>
                </div>

            </div>

            <!-- RIGHT SIDEBAR -->
            <div class="col-lg-4">

                <!-- What happens next -->
                <div class="sidebar-card highlight mb-3">
                    <div class="card-body p-4">
                        <div class="sidebar-title">📋 What happens next?</div>

                        <div class="d-flex gap-3 mb-3">
                            <div class="next-step-num">1</div>
                            <div class="small">
                                <strong>Submit your application</strong><br>
                                <span style="color:rgba(255,255,255,.6)">Takes only 2 minutes</span>
                            </div>
                        </div>
                        <div class="d-flex gap-3 mb-3">
                            <div class="next-step-num">2</div>
                            <div class="small">
                                <strong>We review your application</strong><br>
                                <span style="color:rgba(255,255,255,.6)">Within 24 hours</span>
                            </div>
                        </div>
                        <div class="d-flex gap-3 mb-3">
                            <div class="next-step-num">3</div>
                            <div class="small">
                                <strong>We call you back</strong><br>
                                <span style="color:rgba(255,255,255,.6)">Discuss course & schedule</span>
                            </div>
                        </div>
                        <div class="d-flex gap-3">
                            <div class="next-step-num done">✓</div>
                            <div class="small">
                                <strong>Get enrolled!</strong><br>
                                <span style="color:rgba(255,255,255,.6)">Start your journey</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contact -->
                <div class="sidebar-card">
                    <div class="card-body p-4">
                        <div class="sidebar-title" style="color:var(--nm-text)">📞 Contact Us Directly</div>
                        <div class="contact-row">📍 Sector 17, Chandigarh</div>
                        <div class="contact-row">📞 +91 98765 43210</div>
                        <div class="contact-row">📧 info@edupeak.in</div>
                        <div class="contact-row mb-0">🕐 Mon–Sat, 9 AM – 6 PM</div>
                    </div>
                </div>

            </div>
        </div>
    </form>

</div>

@section Scripts {
    <script>
        document.getElementById('admissionForm').addEventListener('submit', function () {
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Submitting...';
        });
    </script>
}