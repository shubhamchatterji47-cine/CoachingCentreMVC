        ❌ @ViewBag.FormError
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Apply" method="post" id="admissionForm">
    <div class="row g-0">
        <div class="col-lg-8">

            <!-- Personal Info -->
            <div class="form-section">
                <div class="form-section-title">👤 Personal Information</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input name="fullName" class="form-control" placeholder="Your full name"
                               value="@ViewBag.FullName" required maxlength="100" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Date of Birth</label>
                        <input name="dateOfBirth" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                        <input name="email" type="email" class="form-control" placeholder="you@email.com"
                               value="@ViewBag.Email" required maxlength="150" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Phone Number <span class="text-danger">*</span></label>
                        <input name="phoneNumber" type="tel" class="form-control" placeholder="+91 98765 43210"
                               value="@ViewBag.PhoneNumber" required maxlength="20" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Address</label>
                        <input name="address" class="form-control" placeholder="Your full address"
                               value="@ViewBag.Address" maxlength="300" />
                    </div>
                </div>
            </div>

            <!-- Parent Info -->
            <div class="form-section">
                <div class="form-section-title">👨‍👩‍👧 Parent / Guardian Information</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Parent / Guardian Name</label>
                        <input name="parentName" class="form-control" placeholder="Father / Mother name"
                               value="@ViewBag.ParentName" maxlength="100" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Parent Phone</label>
                        <input name="parentPhone" type="tel" class="form-control" placeholder="+91 98765 43210"
                               value="@ViewBag.ParentPhone" maxlength="20" />
                    </div>
                </div>
            </div>

            <!-- Academic Info -->
            <div class="form-section">
                <div class="form-section-title">📚 Academic Background</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Previous School / College</label>
                        <input name="previousSchool" class="form-control"
                               placeholder="e.g. DAV Public School"
                               value="@ViewBag.PreviousSchool" maxlength="200" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Last Class / Standard Passed</label>
                        <input name="lastClassPassed" class="form-control"
                               placeholder="e.g. Class 10, 12th PCM"
                               maxlength="100" />
                    </div>
                </div>
            </div>

            <!-- Course Interest -->
            <div class="form-section">
                <div class="form-section-title">🎯 Course Interest</div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Select Course (if known)</label>
                        <select name="courseId" class="form-select">
                            <option value="">— Not sure yet, I'll discuss —</option>
                            @foreach (var c in courses)
                            {
                                <option value="@c.Id">@c.Name — @c.CategoryName (@c.DurationMonths months)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Or describe your interest</label>
                        <input name="courseInterest" class="form-control"
                               placeholder="e.g. I want to prepare for JEE / NEET"
                               value="@ViewBag.CourseInterest" maxlength="200" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Message / Additional Info</label>
                        <textarea name="message" class="form-control" rows="3"
                                  placeholder="Any questions or details you'd like to share..."
                                  maxlength="1000">@ViewBag.Message</textarea>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 align-items-center flex-wrap mt-2 mb-4">
                <button type="submit" class="btn btn-primary btn-lg px-5" id="submitBtn">
                    📨 Submit Application
                </button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                    ← Back to Home
                </a>
            </div>

        </div>

        <!-- RIGHT SIDEBAR -->
        <div class="col-lg-4 ps-lg-4">
            <div class="card border-0 shadow-sm rounded-3 mb-3" style="background:#f0f7ff;">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">📋 What happens next?</h6>
                    <div class="d-flex gap-2 mb-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                             style="width:28px;height:28px;font-size:.8rem">
                            1
                        </div>
                        <div class="small">
                            <strong>Submit your application</strong><br>
                            <span class="text-muted">Takes only 2 minutes</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mb-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                             style="width:28px;height:28px;font-size:.8rem">
                            2
                        </div>
                        <div class="small">
                            <strong>We review your application</strong><br>
                            <span class="text-muted">Within 24 hours</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mb-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                             style="width:28px;height:28px;font-size:.8rem">
                            3
                        </div>
                        <div class="small">
                            <strong>We call you back</strong><br>
                            <span class="text-muted">Discuss course & schedule</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                             style="width:28px;height:28px;font-size:.8rem">
                            ✓
                        </div>
                        <div class="small">
                            <strong>Get enrolled!</strong><br>
                            <span class="text-muted">Start your journey</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">📞 Contact Us Directly</h6>
                    <div class="small text-muted mb-2">📍 Sector 17, Chandigarh</div>
                    <div class="small text-muted mb-2">📞 +91 98765 43210</div>
                    <div class="small text-muted mb-2">📧 info@edupeak.in</div>
                    <div class="small text-muted">🕐 Mon–Sat, 9 AM – 6 PM</div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.getElementById('admissionForm').addEventListener('submit', function () {
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Submitting...';
        });
    </script>
