@model CoachingMVC.ViewModels.Admission.AdmissionApplicationViewModel
@{
    ViewData["Title"] = "Application Detail";
    var badgeClass = Model.Status switch
    {
        "Pending" => "bg-warning text-dark",
        "Reviewed" => "bg-info",
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2">← Back to Applications</a>
        <h4 class="fw-bold mb-0">📋 Application #@Model.Id</h4>
    </div>
    <span class="badge @badgeClass fs-6 px-3 py-2">@Model.Status</span>
</div>

<div class="row g-4">
    <!-- LEFT: Application Details -->
    <div class="col-lg-8">

        <!-- Personal Info -->
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-semibold">👤 Personal Information</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small">Full Name</div>
                        <div class="fw-semibold">@Model.FullName</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Date of Birth</div>
                        <div class="fw-semibold">@(Model.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Email</div>
                        <div class="fw-semibold">@Model.Email</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Phone</div>
                        <div class="fw-semibold">@Model.PhoneNumber</div>
                    </div>
                    <div class="col-12">
                        <div class="text-muted small">Address</div>
                        <div class="fw-semibold">@(Model.Address ?? "—")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Parent Info -->
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-semibold">👨‍👩‍👧 Parent / Guardian</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small">Parent Name</div>
                        <div class="fw-semibold">@(Model.ParentName ?? "—")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Parent Phone</div>
                        <div class="fw-semibold">@(Model.ParentPhone ?? "—")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Academic -->
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-semibold">📚 Academic Background</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small">Previous School</div>
                        <div class="fw-semibold">@(Model.PreviousSchool ?? "—")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Last Class Passed</div>
                        <div class="fw-semibold">@(Model.LastClassPassed ?? "—")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Course Interest -->
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-semibold">🎯 Course Interest</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small">Selected Course</div>
                        <div class="fw-semibold">
                            @if (!string.IsNullOrEmpty(Model.CourseName))
                            {
                                <span class="badge bg-primary fs-6">@Model.CourseName</span>
                            }
                            else
                            {

                                <span>—</span>
                            }
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">Interest Description</div>
                        <div class="fw-semibold">@(Model.CourseInterest ?? "—")</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Message))
                    {
                        <div class="col-12">
                            <div class="text-muted small">Message from Applicant</div>
                            <div class="p-3 bg-light rounded">@Model.Message</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT: Actions -->
    <div class="col-lg-4">

        <!-- Application Meta -->
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-semibold">📅 Application Info</div>
            <div class="card-body">
                <div class="mb-2">
                    <div class="text-muted small">Applied On</div>
                    <div class="fw-semibold">@Model.AppliedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                </div>
                @if (Model.ReviewedAt.HasValue)
                {
                    <div class="mb-2">
                        <div class="text-muted small">Reviewed On</div>
                        <div class="fw-semibold">@Model.ReviewedAt.Value.ToString("dd MMM yyyy, hh:mm tt")</div>
                    </div>
                }
                <div>
                    <div class="text-muted small">Current Status</div>
                    <span class="badge @badgeClass fs-6">@Model.Status</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.AdminNotes))
                {
                    <div class="mt-2">
                        <div class="text-muted small">Admin Notes</div>
                        <div class="p-2 bg-light rounded small">@Model.AdminNotes</div>
                    </div>
                }
            </div>
        </div>

        <!-- Update Status -->
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-semibold">⚙️ Update Status</div>
            <div class="card-body">
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Status</label>
                        <select name="status" class="form-select">
                            <option value="Pending" selected="@(Model.Status == "Pending")">🕐 Pending</option>
                            <option value="Reviewed" selected="@(Model.Status == "Reviewed")">👁️ Reviewed</option>
                            <option value="Approved" selected="@(Model.Status == "Approved")">✅ Approved</option>
                            <option value="Rejected" selected="@(Model.Status == "Rejected")">❌ Rejected</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Admin Notes</label>
                        <textarea name="adminNotes" class="form-control" rows="3"
                                  placeholder="e.g. Called student, scheduled visit on Monday...">@Model.AdminNotes</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">💾 Save Status</button>
                </form>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">⚡ Quick Actions</div>
            <div class="card-body d-flex flex-column gap-2">
                <a href="tel:@Model.PhoneNumber" class="btn btn-outline-success">
                    📞 Call @Model.PhoneNumber
                </a>
                <a href="mailto:@Model.Email" class="btn btn-outline-info">
                    📧 Email Applicant
                </a>
                <form asp-action="Delete" method="post"
                      onsubmit="return confirm('Permanently delete this application?')">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger w-100">🗑️ Delete Application</button>
                </form>
            </div>
        </div>
    </div>
</div>