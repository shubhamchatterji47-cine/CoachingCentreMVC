@{
    ViewData["Title"] = "Contact Us";
    var courses = ViewBag.Courses as List<CoachingMVC.ViewModels.Shared.CourseViewModel> ?? new();
}

<style>
    :root {
        --nm-navy: #0a1628;
        --nm-blue: #1e40af;
        --nm-accent: #f59e0b;
        --nm-light: #f0f4ff;
    }

    .page-hero {
        background: var(--nm-navy);
        padding: 4rem 0 3rem;
        color: white;
    }

    .section-label {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: rgba(255,255,255,.1);
        color: rgba(255,255,255,.8);
        border-radius: 50px;
        padding: .3rem .9rem;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        margin-bottom: .75rem;
    }

    .contact-info-card {
        background: var(--nm-navy);
        border-radius: 16px;
        padding: 2rem;
        color: white;
        height: 100%;
    }

    .contact-item {
        display: flex;
        align-items: flex-start;
        gap: .875rem;
        margin-bottom: 1.5rem;
    }

    .contact-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: rgba(255,255,255,.08);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .contact-form-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        border: 1.5px solid #e8edf5;
    }

    .form-control, .form-select {
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        padding: .65rem 1rem;
        font-size: .9rem;
        transition: border-color .2s;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--nm-blue);
            box-shadow: 0 0 0 3px rgba(30,64,175,.1);
        }

    .btn-submit {
        background: var(--nm-navy);
        color: white;
        border: none;
        border-radius: 10px;
        padding: .75rem 2rem;
        font-family: 'Sora',sans-serif;
        font-weight: 700;
        transition: all .2s;
        cursor: pointer;
    }

        .btn-submit:hover {
            background: var(--nm-blue);
            transform: translateY(-1px);
        }

        .btn-submit:disabled {
            opacity: .6;
            cursor: not-allowed;
            transform: none;
        }
</style>

<div class="page-hero">
    <div class="container text-center">
        <div class="section-label">📬 Reach Us</div>
        <h1 style="font-family:'Sora',sans-serif;font-weight:800;font-size:2.5rem;letter-spacing:-1px">Contact Us</h1>
        <p style="color:rgba(255,255,255,.6);max-width:440px;margin:.75rem auto 0">Have questions? We're here to help you find the right course.</p>
    </div>
</div>

<section class="py-5">
    <div class="container">

        @if (TempData["ContactSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4">
                <strong>🎉 Thank you!</strong> @TempData["ContactSuccess"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ContactError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4">
                @TempData["ContactError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-4">
            <!-- Info Column -->
            <div class="col-lg-4">
                <div class="contact-info-card">
                    <h5 style="font-family:'Sora',sans-serif;font-weight:700;margin-bottom:1.5rem">Get in Touch</h5>

                    <div class="contact-item">
                        <div class="contact-icon">📍</div>
                        <div>
                            <div style="font-weight:600;margin-bottom:.2rem;font-size:.9rem">Address</div>
                            <div style="color:rgba(255,255,255,.6);font-size:.85rem;line-height:1.6">123 Education Street,<br>Knowledge Park, City - 123456</div>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-icon">📞</div>
                        <div>
                            <div style="font-weight:600;margin-bottom:.2rem;font-size:.9rem">Phone</div>
                            <div style="color:rgba(255,255,255,.6);font-size:.85rem">+91 98765 43210</div>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-icon">📧</div>
                        <div>
                            <div style="font-weight:600;margin-bottom:.2rem;font-size:.9rem">Email</div>
                            <div style="color:rgba(255,255,255,.6);font-size:.85rem">info@nmcoaching.com</div>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-icon">🕐</div>
                        <div>
                            <div style="font-weight:600;margin-bottom:.2rem;font-size:.9rem">Office Hours</div>
                            <div style="color:rgba(255,255,255,.6);font-size:.85rem">Mon–Sat: 8:00 AM – 8:00 PM<br>Sunday: 9:00 AM – 1:00 PM</div>
                        </div>
                    </div>

                    <div style="background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.25);border-radius:10px;padding:1rem;margin-top:.5rem">
                        <div style="color:#fbbf24;font-weight:700;font-size:.85rem;margin-bottom:.3rem">⚡ Quick Response</div>
                        <div style="color:rgba(255,255,255,.6);font-size:.8rem;line-height:1.6">
                            We respond to all messages within <strong style="color:white">24 hours</strong>.
                        </div>
                    </div>

                    <div style="border-top:1px solid rgba(255,255,255,.1);padding-top:1.25rem;margin-top:1.25rem">
                        <div style="font-size:.8rem;color:rgba(255,255,255,.4);margin-bottom:.75rem">Follow Us</div>
                        <div class="d-flex gap-2">
                            <a href="#" style="width:36px;height:36px;background:rgba(255,255,255,.08);border-radius:8px;display:flex;align-items:center;justify-content:center;text-decoration:none">📘</a>
                            <a href="#" style="width:36px;height:36px;background:rgba(255,255,255,.08);border-radius:8px;display:flex;align-items:center;justify-content:center;text-decoration:none">📸</a>
                            <a href="#" style="width:36px;height:36px;background:rgba(255,255,255,.08);border-radius:8px;display:flex;align-items:center;justify-content:center;text-decoration:none">▶️</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form + Map -->
            <div class="col-lg-8 d-flex flex-column gap-4">
                <div class="contact-form-card">
                    <h5 style="font-family:'Sora',sans-serif;font-weight:700;margin-bottom:.4rem">Send a Message</h5>
                    <p class="text-muted small mb-3">Our team will get back to you within 24 hours.</p>

                    <form asp-action="SendMessage" asp-controller="Home" method="post" id="contactForm">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Your Name *</label>
                                <input type="text" name="name" class="form-control"
                                       placeholder="Full name" required maxlength="100" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Email Address *</label>
                                <input type="email" name="email" class="form-control"
                                       placeholder="you@email.com" required maxlength="150" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Phone Number</label>
                                <input type="tel" name="phone" class="form-control"
                                       placeholder="+91 XXXXX XXXXX" maxlength="20" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Subject</label>
                                <select name="subject" class="form-select">
                                    <option value="">— Select a topic —</option>
                                    <option value="Course Enquiry">Course Enquiry</option>
                                    @foreach (var c in courses)
                                    {
                                        <option value="@c.Name">@c.Name</option>
                                    }
                                    <option value="Fee Structure">Fee Structure</option>
                                    <option value="Admissions">Admissions</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Message *</label>
                                <textarea name="message" class="form-control" rows="4"
                                          placeholder="Tell us how we can help..."
                                          required maxlength="1000"></textarea>
                            </div>
                            <div class="col-12 d-flex align-items-center gap-3">
                                <button type="submit" class="btn-submit" id="submitBtn">
                                    Send Message →
                                </button>
                                <span class="text-muted small">We'll respond within 24 hours</span>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Map -->
                <div class="rounded-3 overflow-hidden" style="height:220px;border:1.5px solid #e8edf5">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3430.5!2d76.38!3d30.73!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzDCsDQzJzQ4LjAiTiA3NsKwMjInNDguMCJF!5e0!3m2!1sen!2sin!4v1"
                            width="100%" height="220" style="border:0" allowfullscreen loading="lazy">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById('contactForm').addEventListener('submit', function() {
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.textContent = 'Sending...';
        });
    </script>
}
