@* @{
    ViewData["Title"] = "Home";
    var courses = ViewBag.Courses as List<CoachingMVC.ViewModels.Shared.CourseViewModel> ?? new();
    var categories = ViewBag.Categories as List<CoachingMVC.ViewModels.Admin.CategoryViewModel> ?? new();
    var announcements = ViewBag.Announcements as List<CoachingMVC.ViewModels.Admin.AnnouncementViewModel> ?? new();
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #1a237e 0%, #0d47a1 50%, #1565c0 100%);
        border-radius: 16px;
        padding: 4rem 2rem;
        text-align: center;
        color: white;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }

        .hero-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 400px;
            height: 400px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
        }

        .hero-section::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -5%;
            width: 300px;
            height: 300px;
            background: rgba(255,255,255,0.04);
            border-radius: 50%;
        }

    /* Category cards */
    .cat-card {
        border: 2px solid #e9ecef;
        border-radius: 14px;
        padding: 1.5rem 1rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.25s ease;
        background: #fff;
        user-select: none;
    }

        .cat-card:hover {
            border-color: #0d6efd;
            box-shadow: 0 4px 18px rgba(13,110,253,0.15);
            transform: translateY(-3px);
        }

        .cat-card.active {
            border-color: #0d6efd;
            background: #e7f0ff;
            box-shadow: 0 4px 18px rgba(13,110,253,0.2);
        }

        .cat-card .cat-icon {
            font-size: 2.4rem;
            margin-bottom: 0.5rem;
        }

        .cat-card .cat-name {
            font-weight: 600;
            font-size: .95rem;
            color: #212529;
        }

        .cat-card.active .cat-name {
            color: #0d6efd;
        }

    /* Category detail panel */
    .cat-detail-panel {
        display: none;
        animation: fadeSlideIn 0.3s ease;
    }

        .cat-detail-panel.visible {
            display: block;
        }

    @@keyframes fadeSlideIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .cat-feature-list li {
        padding: 0.35rem 0;
    }

        .cat-feature-list li::before {
            content: "✓ ";
            color: #0d6efd;
            font-weight: 700;
        }

    /* Course cards */
    .course-card {
        border-radius: 12px;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .course-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        }

        .course-card[data-category] {
            transition: opacity 0.3s, transform 0.3s;
        }

        .course-card.hidden {
            display: none;
        }
</style>

<!-- Hero -->
<div class="hero-section">
    <div style="font-size:3rem;margin-bottom:.75rem;">🎓</div>
    <h1 style="font-size:2.4rem;font-weight:800;margin-bottom:.75rem;">Welcome to Coaching Centre</h1>
    <p style="font-size:1.1rem;opacity:.9;margin-bottom:2rem;">Empowering students with quality education and expert guidance</p>
    <div class="d-flex gap-3 justify-content-center flex-wrap">
        <a asp-action="Courses" class="btn btn-light btn-lg px-4 fw-semibold">Browse Courses</a>
        <a asp-action="Classes" class="btn btn-outline-light btn-lg px-4 fw-semibold">View Classes</a>
        <a asp-controller="Admission" asp-action="Apply" class="btn btn-warning btn-lg px-4 fw-semibold text-dark">📝 Apply / Register</a>
    </div>
</div>

<!-- Announcement banner -->
@if (announcements.Any())
{
    <div class="alert alert-info d-flex align-items-start gap-2 mb-4 rounded-3">
        <span class="fs-5">📢</span>
        <div>
            <strong>Notice:</strong> @announcements.First().Title —
            <span class="text-muted small">@announcements.First().Content</span>
        </div>
    </div>
}

<!-- ───── CATEGORIES ───── -->
<h4 class="fw-bold mb-3">Explore Categories</h4>

@{
    // Static enrichment data per category keyword
    var catData = new Dictionary<string, (string Icon, string Tagline, string[] Features, string[] Exams, string Color)>
    {
        ["academic"] = ("📚", "Strong foundation for school & college",
            new[] { "CBSE & ICSE Board prep", "Science, Maths, English, SST", "Regular tests & doubt sessions", "Performance tracking", "Chapter-wise notes" },
            new[] { "Class 9–12 Boards", "College Entrance", "Olympiads", "NTSE" }, "#0d6efd"),

        ["competitive"] = ("🏆", "Crack India's toughest entrance exams",
            new[] { "Expert faculty with 10+ years experience", "Full-length mock tests", "Previous year paper analysis", "Rank improvement programs", "24/7 doubt support" },
            new[] { "JEE Main & Advanced", "NEET UG", "CUET", "NDA", "CAT / MBA" }, "#dc3545"),

        ["skill"] = ("🛠️", "Practical skills for the real world",
            new[] { "Hands-on project-based learning", "Industry-aligned curriculum", "Certificate on completion", "Small batch sizes", "Job placement support" },
            new[] { "Web Development", "Data Science", "Digital Marketing", "Graphic Design", "Spoken English" }, "#198754"),

        ["language"] = ("🌐", "Communicate confidently in any language",
            new[] { "Native & certified instructors", "Conversational practice sessions", "Grammar & writing workshops", "Cultural immersion activities", "Online + offline batches" },
            new[] { "English Communication", "Hindi", "French", "German", "Sanskrit" }, "#fd7e14"),
    };

    string MatchKey(string name)
    {
        var n = name.ToLower();
        if (n.Contains("academ") || n.Contains("school") || n.Contains("board")) return "academic";
        if (n.Contains("compet") || n.Contains("exam") || n.Contains("entrance") || n.Contains("jee") || n.Contains("neet")) return "competitive";
        if (n.Contains("skill") || n.Contains("voc") || n.Contains("tech") || n.Contains("it") || n.Contains("computer")) return "skill";
        if (n.Contains("lang") || n.Contains("english") || n.Contains("hindi") || n.Contains("french")) return "language";
        return "academic"; // default fallback
    }
}

<div class="row g-3 mb-2" id="catRow">
    @for (int i = 0; i < categories.Count; i++)
    {
        var cat = categories[i];
        var key = MatchKey(cat.Name);
        var d = catData.ContainsKey(key) ? catData[key] : catData["academic"];
        <div class="col-6 col-md-3">
            <div class="cat-card" data-cat-id="cat-@i" onclick="selectCategory(this, 'cat-@i')">
                <div class="cat-icon">@(cat.Icon ?? d.Icon)</div>
                <div class="cat-name">@cat.Name</div>
            </div>
        </div>
    }
</div>

<!-- Category Detail Panels -->
@for (int i = 0; i < categories.Count; i++)
{
    var cat = categories[i];
    var key = MatchKey(cat.Name);
    var d = catData.ContainsKey(key) ? catData[key] : catData["academic"];
    <div class="cat-detail-panel mb-4" id="cat-@i">
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-body p-0">
                <div class="row g-0">
                    <!-- Left: info -->
                    <div class="col-md-8 p-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span style="font-size:2rem;">@(cat.Icon ?? d.Icon)</span>
                            <div>
                                <h5 class="fw-bold mb-0" style="color:@d.Color">@cat.Name</h5>
                                <div class="text-muted small">@d.Tagline</div>
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="fw-semibold mb-2 small text-uppercase text-muted">What you get</div>
                                <ul class="list-unstyled cat-feature-list mb-0">
                                    @foreach (var f in d.Features)
                                    {
                                        <li class="small">@f</li>
                                    }
                                </ul>
                            </div>
                            <div class="col-sm-6">
                                <div class="fw-semibold mb-2 small text-uppercase text-muted">Courses / Exams covered</div>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var e in d.Exams)
                                    {
                                        <span class="badge rounded-pill py-2 px-3" style="background:@d.Color;font-size:.8rem;">@e</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Right: stats + CTA -->
                    <div class="col-md-4 p-4 d-flex flex-column justify-content-between"
                         style="background:@d.Color;color:white;">
                        <div>
                            <div class="fw-bold mb-3" style="font-size:1.1rem;">@cat.Name at a Glance</div>
                            <div class="d-flex flex-column gap-3">
                                <div>
                                    <div style="font-size:1.8rem;font-weight:800;">@(courses.Count(c => c.CategoryName == cat.Name))</div>
                                    <div style="opacity:.85;font-size:.85rem;">Available Courses</div>
                                </div>
                                <div>
                                    <div style="font-size:1.8rem;font-weight:800;">@d.Exams.Length+</div>
                                    <div style="opacity:.85;font-size:.85rem;">Exam Targets</div>
                                </div>
                                <div>
                                    <div style="font-size:1.8rem;font-weight:800;">95%</div>
                                    <div style="opacity:.85;font-size:.85rem;">Success Rate</div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button onclick="filterCourses('@cat.Name')"
                                    class="btn btn-light fw-semibold w-100">
                                View @cat.Name Courses →
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ───── FEATURED COURSES ───── -->
<div class="d-flex justify-content-between align-items-center mb-3 mt-2">
    <h4 class="fw-bold mb-0">
        Featured Courses
        <span id="filterLabel" class="badge bg-primary ms-2 small" style="display:none;"></span>
    </h4>
    <div class="d-flex gap-2 align-items-center">
        <button id="clearFilterBtn" onclick="clearFilter()" class="btn btn-sm btn-outline-secondary" style="display:none;">✕ Show All</button>
        <a asp-action="Courses" class="btn btn-outline-primary btn-sm">View All</a>
    </div>
</div>

@if (courses.Any())
{
    <div class="row g-3 mb-4" id="courseGrid">
        @foreach (var c in courses)
        {
            <div class="col-md-4 course-card-wrap" data-category="@c.CategoryName">
                <div class="card course-card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h6 class="fw-bold mb-0">@c.Name</h6>
                            <span class="badge rounded-pill bg-light text-dark border small">@c.CategoryName</span>
                        </div>
                        <p class="text-muted small mb-2">@(c.Description ?? "Quality education delivered by expert instructors.")</p>
                        <div class="d-flex gap-2 flex-wrap small">
                            <span class="badge bg-light text-dark">⏱ @c.DurationMonths months</span>
                            @if (c.Fee.HasValue)
                            {
                                <span class="badge bg-success text-white">💰 ₹@c.Fee</span>
                            }
                            <span class="badge bg-info text-dark">🏫 @c.ClassCount class@(c.ClassCount != 1 ? "es" : "")</span>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent pt-0 border-0 pb-3 px-3">
                        <a asp-action="Courses" class="btn btn-sm btn-primary w-100">Enroll Now</a>
                    </div>
                </div>
            </div>
        }
    </div>
    <div id="noCoursesMsg" class="text-muted text-center py-4" style="display:none;">
        No courses found in this category yet.
    </div>
}
else
{
    <div class="text-muted text-center py-4 mb-4">No courses available yet.</div>
}

<!-- Stats -->
<div class="row g-3 text-center rounded-3 py-4 mb-2" style="background:#f8f9fa;">
    <div class="col-sm-4">
        <div class="fs-2 fw-bold text-primary">500+</div>
        <div class="text-muted">Students Enrolled</div>
    </div>
    <div class="col-sm-4">
        <div class="fs-2 fw-bold text-success">50+</div>
        <div class="text-muted">Expert Teachers</div>
    </div>
    <div class="col-sm-4">
        <div class="fs-2 fw-bold text-info">95%</div>
        <div class="text-muted">Success Rate</div>
    </div>
</div>

@section Scripts {
    <script>
        var activeCard = null;

        function selectCategory(el, panelId) {
            // Toggle off if clicking same card
            if (activeCard === el) {
                el.classList.remove('active');
                document.getElementById(panelId).classList.remove('visible');
                activeCard = null;
                return;
            }
            // Deactivate all
            document.querySelectorAll('.cat-card').forEach(c => c.classList.remove('active'));
            document.querySelectorAll('.cat-detail-panel').forEach(p => p.classList.remove('visible'));
            // Activate clicked
            el.classList.add('active');
            document.getElementById(panelId).classList.add('visible');
            activeCard = el;
            // Smooth scroll to panel
            setTimeout(() => {
                document.getElementById(panelId).scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }, 50);
        }

        function filterCourses(categoryName) {
            var wraps = document.querySelectorAll('.course-card-wrap');
            var shown = 0;
            wraps.forEach(function(w) {
                if (w.dataset.category === categoryName) { w.style.display = ''; shown++; }
                else { w.style.display = 'none'; }
            });
            document.getElementById('filterLabel').textContent = categoryName;
            document.getElementById('filterLabel').style.display = '';
            document.getElementById('clearFilterBtn').style.display = '';
            document.getElementById('noCoursesMsg').style.display = shown === 0 ? '' : 'none';
            // Scroll to courses
            document.getElementById('courseGrid').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function clearFilter() {
            document.querySelectorAll('.course-card-wrap').forEach(w => w.style.display = '');
            document.getElementById('filterLabel').style.display = 'none';
            document.getElementById('clearFilterBtn').style.display = 'none';
            document.getElementById('noCoursesMsg').style.display = 'none';
        }
    </script>
} *@
@{
    ViewData["Title"] = "Home";
    var courses = ViewBag.Courses as List<CoachingMVC.ViewModels.Shared.CourseViewModel> ?? new();
    var categories = ViewBag.Categories as List<CoachingMVC.ViewModels.Admin.CategoryViewModel> ?? new();
    var announcements = ViewBag.Announcements as List<CoachingMVC.ViewModels.Admin.AnnouncementViewModel> ?? new();
}

<style>
