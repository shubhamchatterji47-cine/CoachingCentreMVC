        font-weight: 700;
        font-size: 1rem;
        margin-bottom: .2rem;
    }

    .teacher-subject {
        font-size: .82rem;
        color: var(--nm-muted);
        margin-bottom: .5rem;
    }
    /* TESTIMONIALS */
    .testimonial-card {
        background: white;
        border: 1.5px solid #e8edf5;
        border-radius: 16px;
        padding: 1.75rem;
        transition: all .25s;
    }

        .testimonial-card:hover {
            box-shadow: 0 12px 40px rgba(0,0,0,.08);
        }

    .testimonial-quote {
        font-size: 2.5rem;
        color: var(--nm-accent);
        line-height: 1;
        margin-bottom: .5rem;
    }

    .testimonial-text {
        color: #475569;
        line-height: 1.75;
        font-size: .92rem;
        margin-bottom: 1rem;
    }

    .testimonial-stars {
        color: var(--nm-accent);
        font-size: .9rem;
    }

    .testimonial-name {
        font-family: 'Sora',sans-serif;
        font-weight: 700;
        font-size: .92rem;
    }

    .testimonial-batch {
        font-size: .78rem;
        color: var(--nm-muted);
    }
    /* HOW IT WORKS */
    .step-card {
        text-align: center;
        padding: 1.5rem 1rem;
    }

    .step-num {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: var(--nm-blue);
        color: white;
        font-family: 'Sora',sans-serif;
        font-weight: 800;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
    }
    /* CTA STRIP */
    .cta-strip {
        background: linear-gradient(135deg,var(--nm-navy) 0%,var(--nm-blue) 100%);
        color: white;
        border-radius: 20px;
        padding: 3rem 2.5rem;
    }
    /* ANNOUNCEMENT */
    .ann-strip {
        background: rgba(245,158,11,.08);
        border-left: 4px solid var(--nm-accent);
        border-radius: 0 8px 8px 0;
        padding: .75rem 1.25rem;
    }
</style>

<!-- ════════════ HERO ════════════ -->
<section class="hero-section">
    <div class="hero-grid"></div>
    <div class="container position-relative py-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="hero-badge">🏆 Ranked #1 Coaching in the Region</div>
                <h1 class="hero-title">
                    Learn Smarter.<br>
                    Score <span class="accent">Higher.</span><br>
                    Dream Bigger.
                </h1>
                <p class="hero-subtitle">
                    N.M. Coaching Centre — founded by Neeraj Sisodiya — has guided 500+ students to top scores in JEE, NEET, Board exams and beyond. Small batches. Expert faculty. Real results.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-action="Courses" class="hero-btn-primary">Explore Courses</a>
                    <a asp-controller="Admission" asp-action="Apply" class="hero-btn-primary">📝 Apply / Register</a>
                </div>
                <div class="d-flex gap-4 mt-4 pt-2 border-top border-secondary">
                    <div class="hero-stat"><div class="hero-stat-num">500+</div><div class="hero-stat-label">Students</div></div>
                    <div class="hero-stat"><div class="hero-stat-num">95%</div><div class="hero-stat-label">Success Rate</div></div>
                    <div class="hero-stat"><div class="hero-stat-num">10+</div><div class="hero-stat-label">Years</div></div>
                    <div class="hero-stat"><div class="hero-stat-num">50+</div><div class="hero-stat-label">Teachers</div></div>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <div class="row g-3">
                    <div class="col-12">
                        <div class="hero-card">
                            <div class="hero-card-tag">Today's Highlight</div>
                            <div class="hero-card-title">JEE Advanced Batch 2025 — Now Enrolling</div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="hero-pill">🟢 Seats Available</span>
                                <a asp-action="Courses" class="text-warning small fw-bold text-decoration-none">Enroll →</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="hero-card">
                            <div class="hero-card-tag">Results 2024</div>
                            <div class="hero-card-title" style="font-size:.95rem">12 Students in Top 1000 JEE</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="hero-card">
                            <div class="hero-card-tag">NEET 2024</div>
                            <div class="hero-card-title" style="font-size:.95rem">8 Students scored 680+</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="hero-card d-flex align-items-center gap-3">
                            <div style="font-size:2.5rem">👨‍🏫</div>
                            <div>
                                <div class="hero-card-tag">Founder & Director</div>
                                <div class="hero-card-title" style="font-size:.95rem">Neeraj Sisodiya — M.Sc. Mathematics, 10+ yrs</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ANNOUNCEMENT STRIP -->
@if (announcements.Any())
{
    <div class="bg-warning bg-opacity-10 py-2 border-bottom">
        <div class="container">
            <div class="ann-strip d-flex align-items-center gap-2">
                <span class="fw-bold text-warning small">📢 Notice:</span>
                <span class="small text-dark">@announcements.First().Title — @announcements.First().Content</span>
            </div>
        </div>
    </div>
}

<!-- ════════════ CATEGORIES ════════════ -->
<section class="py-5" style="background:#fafbff">
    <div class="container">
        <div class="text-center mb-4">
            <div class="section-label">📚 What We Teach</div>
            <h2 class="section-title">Explore Our <span style="color:var(--nm-blue)">Programs</span></h2>
        </div>
        <div class="d-flex flex-wrap justify-content-center gap-3">
            @{
                var catIcons = new[] { "📐", "🔬", "🏆", "🌐", "💻", "📖" };
                int ci = 0;
            }
            @foreach (var cat in categories)
            {
                <a asp-action="Courses" class="cat-chip">
                    <span class="cat-emoji">@catIcons[ci % catIcons.Length]</span>
                    @cat.Name
                </a>
                ci++;
            }
            @if (!categories.Any())
            {
                foreach (var item in new[] { ("📐", "Mathematics"), ("🔬", "Science"), ("🏆", "Competitive Exams"), ("🌐", "Languages"), ("💻", "Computer Science") })
                {
                    <a asp-action="Courses" class="cat-chip"><span class="cat-emoji">@item.Item1</span>@item.Item2</a>
                }
            }
        </div>
    </div>
</section>

<!-- ════════════ FEATURED COURSES ════════════ -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
            <div>
                <div class="section-label">🎯 Top Picks</div>
                <h2 class="section-title mb-0">Featured <span style="color:var(--nm-blue)">Courses</span></h2>
            </div>
            <a asp-action="Courses" class="btn btn-outline-primary rounded-pill px-4 fw-600">View All Courses →</a>
        </div>
        @{
            var courseIcons = new[] { "📐", "🔬", "🧬", "💻", "🌐", "📖", "🏆", "✏️" };
            int courseIdx = 0;
        }
        <div class="row g-3">
            @if (courses.Any())
            {
                @foreach (var c in courses.Take(6))
                {
                    <div class="col-md-4">
                        <div class="course-card">
                            <div class="course-card-top">
                                <div class="course-card-icon">@courseIcons[courseIdx % courseIcons.Length]</div>
                                <div style="font-family:'Sora',sans-serif;font-weight:700;font-size:1.05rem">@c.Name</div>
                                @if (c.Fee.HasValue)
                                {
                                    <div style="font-size:.85rem;opacity:.8;margin-top:.25rem">₹@c.Fee · @c.DurationMonths months</div>
                                }
                            </div>
                            <div class="course-card-body">
                                <span class="course-tag">@c.CategoryName</span>
                                <p class="mt-2 mb-0 small" style="color:#64748b;line-height:1.6">
                                    @(string.IsNullOrEmpty(c.Description) ? "Expert-led course with structured curriculum, regular tests, and personal mentoring." : c.Description)
                                </p>
                                <div class="course-meta">
                                    <span>🏫 @c.ClassCount class@(c.ClassCount != 1 ? "es" : "")</span>
                                    <span>⏱ @c.DurationMonths months</span>
                                    @if (c.Fee.HasValue)
                                    {
                                        <span>💰 ₹@c.Fee</span>
                                    }
                                </div>
                                <a asp-controller="Account" asp-action="Login" class="course-enroll">Enroll Now</a>
                            </div>
                        </div>
                    </div>
                    courseIdx++;
                }
            }
            else
            {
                foreach (var item in new[] {
                        ("📐","JEE Mathematics","Competitive Exams","Full syllabus coverage with 500+ practice problems."),
                        ("🔬","NEET Physics","Science","Topic-wise study with previous year analysis."),
                        ("🧬","NEET Biology","Science","In-depth NCERT-based preparation."),
                        ("💻","Computer Science","Technology","Programming, algorithms, and board prep."),
                        ("📖","English Communication","Language","Spoken & written English for all ages."),
                        ("🏆","Board Exam Booster","Academic","Class 10 & 12 complete preparation.")
                        })
                {
                    <div class="col-md-4">
                        <div class="course-card">
                            <div class="course-card-top">
                                <div class="course-card-icon">@item.Item1</div>
                                <div style="font-family:'Sora',sans-serif;font-weight:700;font-size:1.05rem">@item.Item2</div>
                            </div>
                            <div class="course-card-body">
                                <span class="course-tag">@item.Item3</span>
                                <p class="mt-2 mb-0 small" style="color:#64748b;line-height:1.6">@item.Item4</p>
                                <a asp-controller="Account" asp-action="Login" class="course-enroll mt-3">Enroll Now</a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- ════════════ HOW IT WORKS ════════════ -->
<section class="py-5" style="background:#fafbff">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-label">🚀 Simple Process</div>
            <h2 class="section-title">How It <span style="color:var(--nm-blue)">Works</span></h2>
        </div>
        <div class="row g-3 text-center">
            @foreach (var step in new[] {
                        ("01","Choose a Course","Browse our programs and find the one that matches your goal.","📚"),
                        ("02","Register & Enroll","Login and complete your enrollment in minutes.","📝"),
                        ("03","Attend Classes","Join small-batch classes with expert teachers.","🏫"),
                        ("04","Track Progress","Monitor marks, performance reports, and improvement tips.","📈")
                        })
            {
                <div class="col-md-3">
                    <div class="step-card">
                        <div class="step-num">@step.Item1</div>
                        <div style="font-size:2rem;margin-bottom:.5rem">@step.Item4</div>
                        <div style="font-family:'Sora',sans-serif;font-weight:700;font-size:1rem;margin-bottom:.4rem">@step.Item2</div>
                        <div style="color:#64748b;font-size:.875rem;line-height:1.6">@step.Item3</div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ════════════ TEACHERS ════════════ -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-label">👨‍🏫 Our Experts</div>
            <h2 class="section-title">Meet Our <span style="color:var(--nm-blue)">Teachers</span></h2>
            <p class="text-muted mt-2">Qualified, experienced, and passionate about your success</p>
        </div>
        <div class="row g-3 justify-content-center">
            @{
                var teacherColors = new[] { "#1e40af", "#0f766e", "#7c3aed", "#b45309", "#be185d" };
                var teacherData = new[] {
                        ("N","Neeraj Sisodiya","Mathematics","M.Sc. Math · 10+ yrs","Founder & Director"),
                        ("P","Parveen Kaur","Chemistry","M.Sc. Chemistry · 5 yrs","Senior Faculty"),
                        ("R","Rahul Sharma","Physics","B.Tech · IIT · 7 yrs","Physics Expert"),
                        ("A","Anita Singh","Biology","M.Sc. Biology · 6 yrs","NEET Specialist")
                        };
                int ti = 0;
            }
            @foreach (var t in teacherData)
            {
                <div class="col-6 col-md-3">
                    <div class="teacher-card">
                        <div class="teacher-avatar" style="background:@teacherColors[ti % teacherColors.Length]">@t.Item1</div>
                        <div class="teacher-name">@t.Item2</div>
                        <div class="teacher-subject">@t.Item3</div>
                        <div class="d-flex justify-content-center gap-1 flex-wrap">
                            <span class="badge" style="background:#f0f4ff;color:#1e40af;font-size:.7rem">@t.Item4</span>
                        </div>
                        <div class="mt-2" style="font-size:.75rem;color:#94a3b8">@t.Item5</div>
                    </div>
                </div>
                ti++;
            }
        </div>
    </div>
</section>

<!-- ════════════ TESTIMONIALS ════════════ -->
<section class="py-5" style="background:#fafbff">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-label">💬 Student Stories</div>
            <h2 class="section-title">What Our <span style="color:var(--nm-blue)">Students Say</span></h2>
        </div>
        <div class="row g-3">
            @foreach (var tm in new[] {
                        ("Rohit Sharma","JEE 2024 · AIR 847","The structured teaching and weekly tests at N.M. Coaching made all the difference. Cleared JEE with AIR 847 — something I never imagined possible two years ago.","⭐⭐⭐⭐⭐"),
                        ("Priya Patel","NEET 2024 · 695/720","Sir's biology notes are gold. The personal attention in small batches and regular doubt sessions helped me score 695 in NEET. Forever grateful!","⭐⭐⭐⭐⭐"),
                        ("Amit Kumar","Class 12 Boards · 97%","From 72% in Class 11 to 97% in Boards — that transformation happened here. The teachers genuinely care about each student's improvement.","⭐⭐⭐⭐⭐")
                        })
            {
                <div class="col-md-4">
                    <div class="testimonial-card">
                        <div class="testimonial-quote">"</div>
                        <p class="testimonial-text">@tm.Item3</p>
                        <div class="testimonial-stars mb-2">@tm.Item4</div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width:38px;height:38px;font-family:'Sora',sans-serif;flex-shrink:0">@tm.Item1[0]</div>
                            <div>
                                <div class="testimonial-name">@tm.Item1</div>
                                <div class="testimonial-batch">@tm.Item2</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ════════════ CTA ════════════ -->
<section class="py-5">
    <div class="container">
        <div class="cta-strip text-center">
            <div style="font-size:2.5rem;margin-bottom:.75rem">🚀</div>
            <h2 style="font-family:'Sora',sans-serif;font-weight:800;font-size:2rem;margin-bottom:.75rem">Ready to Start Your Success Story?</h2>
            <p style="color:rgba(255,255,255,.7);max-width:480px;margin:0 auto 1.75rem;line-height:1.7">
