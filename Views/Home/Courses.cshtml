@model List<CoachingMVC.ViewModels.Shared.CourseViewModel>
@using CoachingMVC.ViewModels.Admin
@{
    ViewData["Title"] = "Courses";
    var categories = ViewBag.Categories as List<CategoryViewModel> ?? new();
    var courseIcons = new[] { "📐","🔬","🧬","💻","🌐","📖","🏆","✏️","🎯","🔭" };
}

<style>
    :root { --nm-navy:#0a1628;--nm-blue:#1e40af;--nm-accent:#f59e0b;--nm-light:#f0f4ff; }
    .page-hero { background:var(--nm-navy);padding:4rem 0 3rem;color:white; }
    .section-label { display:inline-flex;align-items:center;gap:.4rem;background:var(--nm-light);color:var(--nm-blue);border-radius:50px;padding:.3rem .9rem;font-size:.78rem;font-weight:700;letter-spacing:.5px;text-transform:uppercase;margin-bottom:.75rem; }
    .filter-btn { border:1.5px solid #e2e8f0;background:white;color:#475569;border-radius:50px;padding:.4rem 1.1rem;font-size:.83rem;font-weight:600;cursor:pointer;transition:all .2s; }
    .filter-btn:hover,.filter-btn.active { border-color:var(--nm-blue);background:var(--nm-light);color:var(--nm-blue); }
    .course-card { border:1.5px solid #e8edf5;border-radius:16px;background:white;transition:all .25s;overflow:hidden;height:100%; }
    .course-card:hover { border-color:var(--nm-blue);box-shadow:0 12px 40px rgba(30,64,175,.12);transform:translateY(-4px); }
    .course-card-top { background:linear-gradient(135deg,var(--nm-blue),#1d4ed8);padding:1.5rem;color:white;position:relative;overflow:hidden; }
    .course-card-top::after { content:'';position:absolute;top:-20px;right:-20px;width:80px;height:80px;background:rgba(255,255,255,.07);border-radius:50%; }
    .course-tag { display:inline-block;background:var(--nm-light);color:var(--nm-blue);border-radius:6px;padding:.2rem .6rem;font-size:.72rem;font-weight:700; }
    .course-enroll { display:block;text-align:center;background:var(--nm-navy);color:white;border-radius:8px;padding:.6rem;font-weight:700;font-size:.85rem;text-decoration:none;transition:all .2s; }
    .course-enroll:hover { background:var(--nm-blue);color:white; }
    .hidden { display:none!important; }
</style>

<!-- Page Hero -->
<div class="page-hero">
    <div class="container text-center">
        <div class="section-label" style="background:rgba(255,255,255,.1);color:rgba(255,255,255,.8)">📚 All Programs</div>
        <h1 style="font-family:'Sora',sans-serif;font-weight:800;font-size:2.5rem;letter-spacing:-1px">Our Courses</h1>
        <p style="color:rgba(255,255,255,.6);max-width:480px;margin:.75rem auto 0">Structured programs designed to help you achieve top scores in every exam</p>
    </div>
</div>

<section class="py-5">
    <div class="container">
        <!-- Category Filter -->
        <div class="d-flex flex-wrap gap-2 mb-4 align-items-center">
            <span class="text-muted small fw-semibold me-1">Filter:</span>
            <button class="filter-btn active" onclick="filterCourses('all', this)">All (@Model.Count)</button>
            @foreach (var cat in categories)
            {
                var cnt = Model.Count(c => c.CategoryName == cat.Name);
                if (cnt > 0)
                { <button class="filter-btn" onclick="filterCourses('@cat.Name', this)">@cat.Name (@cnt)</button> }
            }
        </div>

        <!-- Courses Grid -->
        <div class="row g-3" id="coursesGrid">
            @{ int idx = 0; }
            @if (Model.Any())
            {
                @foreach (var c in Model)
                {
                    <div class="col-md-4 course-item" data-cat="@c.CategoryName">
                        <div class="course-card">
                            <div class="course-card-top">
                                <div style="font-size:2rem;margin-bottom:.5rem">@courseIcons[idx % courseIcons.Length]</div>
                                <div style="font-family:'Sora',sans-serif;font-weight:700;font-size:1.05rem">@c.Name</div>
                                @if (c.Fee.HasValue) { <div style="font-size:.82rem;opacity:.75;margin-top:.2rem">₹@c.Fee · @c.DurationMonths months</div> }
                            </div>
                            <div style="padding:1.25rem">
                                <span class="course-tag">@c.CategoryName</span>
                                <p class="mt-2 mb-2 small" style="color:#64748b;line-height:1.65">
                                    @(string.IsNullOrEmpty(c.Description) ? "Expert-led program with structured curriculum, regular assessments, and personalized guidance." : c.Description)
                                </p>
                                <div style="display:flex;gap:1rem;font-size:.78rem;color:#94a3b8;border-top:1px solid #f1f5f9;padding-top:.75rem;margin-bottom:.75rem">
                                    <span>🏫 @c.ClassCount class@(c.ClassCount != 1 ? "es" : "")</span>
                                    <span>⏱ @c.DurationMonths months</span>
                                </div>
                                <a asp-controller="Account" asp-action="Login" class="course-enroll">Enroll Now</a>
                            </div>
                        </div>
                    </div>
                    idx++;
                }
            }
            else
            {
                <div class="col-12 text-center py-5 text-muted">
                    <div style="font-size:3rem">📚</div>
                    <div class="fw-semibold mt-2">No courses available yet.</div>
                </div>
            }
        </div>
        <div id="noCourses" class="text-center py-5 text-muted" style="display:none">
            <div style="font-size:2.5rem">🔍</div>
            <div class="fw-semibold mt-2">No courses in this category.</div>
        </div>
    </div>
</section>

@section Scripts {
<script>
function filterCourses(cat, btn) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const items = document.querySelectorAll('.course-item');
    let shown = 0;
    items.forEach(item => {
        const show = cat === 'all' || item.dataset.cat === cat;
        item.classList.toggle('hidden', !show);
        if (show) shown++;
    });
    document.getElementById('noCourses').style.display = shown === 0 ? '' : 'none';
}
</script>
}

