```cshtml
@{
    ViewData["Title"] = "About Us";
}

<style>
    :root {
        --nm-navy: #0a1628;
        --nm-blue: #1e40af;
        --nm-accent: #f59e0b;
        --nm-light: #f0f4ff;
        --nm-text: #1e293b;
        --nm-muted: #64748b;
    }

    body {
        background: #f8fafc;
    }

    /* HERO */
    .about-hero {
        background: var(--nm-navy);
        border-radius: 24px;
        padding: 4rem 3rem;
        color: white;
        margin-bottom: 2.5rem;
        position: relative;
        overflow: hidden;
    }

        .about-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top right, rgba(30,64,175,0.45), transparent 40%), radial-gradient(circle at bottom left, rgba(245,158,11,0.18), transparent 35%);
        }

    .about-hero-grid {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
        background-size: 50px 50px;
    }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .hero-badge {
        display: inline-block;
        background: rgba(245,158,11,.15);
        border: 1px solid rgba(245,158,11,.35);
        color: #fbbf24;
        padding: .4rem 1rem;
        border-radius: 50px;
        font-size: .8rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .about-hero h1 {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 800;
        margin-bottom: .8rem;
        letter-spacing: -1px;
    }

    .about-hero p {
        color: rgba(255,255,255,.7);
        font-size: 1.05rem;
    }

    /* SECTION LABEL */
    .section-label {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: var(--nm-light);
        color: var(--nm-blue);
        border-radius: 50px;
        padding: .35rem 1rem;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        margin-bottom: .75rem;
    }

    /* CARDS */
    .card {
        border: 1px solid #e8edf5 !important;
        border-radius: 18px !important;
        overflow: hidden;
        transition: .25s;
        box-shadow: 0 4px 20px rgba(0,0,0,.04);
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 35px rgba(30,64,175,.08);
        }

    /* FOUNDER */
    .founder-avatar {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--nm-blue), #2563eb);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.8rem;
        font-weight: 800;
        color: white;
        margin: 0 auto 1rem;
        border: 4px solid white;
        box-shadow: 0 8px 24px rgba(37,99,235,.3);
    }

    /* STATS */
    .stat-card {
        border-radius: 18px;
        padding: 2rem 1rem;
        text-align: center;
        transition: .25s;
        border: none;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,.12);
        }

    /* VALUE ITEMS */
    .value-item {
        border-left: 4px solid var(--nm-blue);
        padding: .85rem 1rem;
        margin-bottom: .8rem;
        background: #f8faff;
        border-radius: 0 10px 10px 0;
        transition: .2s;
    }

        .value-item:hover {
            transform: translateX(4px);
            background: #eef4ff;
        }

    /* TIMELINE */
    .timeline-item {
        position: relative;
        padding-left: 2rem;
        margin-bottom: 1.5rem;
    }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 6px;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: var(--nm-blue);
            box-shadow: 0 0 0 4px rgba(30,64,175,.12);
        }

        .timeline-item::after {
            content: '';
            position: absolute;
            left: 6px;
            top: 22px;
            width: 2px;
            height: calc(100% + 10px);
            background: #dbe4f0;
        }

        .timeline-item:last-child::after {
            display: none;
        }

    /* ANIMATION */
    .card,
    .stat-card,
    .value-item {
        animation: fadeUp .5s ease;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

