<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - N.M. Coaching Centre</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>

@{
    var role         = Context.Session.GetString("Role");
    var fullName     = Context.Session.GetString("FullName");
    bool isLoggedIn  = !string.IsNullOrEmpty(role);
    bool isPublic    = !isLoggedIn;
    var curAction    = ViewContext.RouteData.Values["action"]?.ToString();
    var curController= ViewContext.RouteData.Values["controller"]?.ToString();
}

@if (isPublic)
{
    <!-- PUBLIC NAVBAR -->
   <nav class="navbar navbar-expand-lg navbar-dark fixed-top"
     style="background:#1a1a2e; border-bottom:1px solid rgba(255,255,255,.08);">
    <div class="container">

        <!-- ── Brand ── -->
        <a class="navbar-brand fw-bold" href="/" style="font-size:1.25rem;">
            <span style="color:#f59e0b;">N.M.</span> Coaching
        </a>

        <!-- ── Toggler: ONLY visible below lg (< 992px) ── -->
        <button class="navbar-toggler border-0 shadow-none"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNav"
                aria-controls="mainNav"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- ── Collapsible Nav ── -->
        <div class="collapse navbar-collapse" id="mainNav">

            <!-- Center links -->
            <ul class="navbar-nav mx-auto gap-1">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Courses">Courses</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Classes">Classes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                </li>
            </ul>

            <!-- Right side: Login -->
            <div class="d-flex">
                <a asp-controller="Account" asp-action="Login"
                   class="btn btn-outline-warning btn-sm px-3 fw-semibold"
                   style="border-radius:8px;">
                    Login →
                </a>
            </div>
        </div>
    </div>
</nav>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-0 rounded-0">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-0 rounded-0">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <main>@RenderBody()</main>

    <!-- PUBLIC FOOTER -->
    <footer class="nm-footer pt-5 pb-0 mt-5">
        <div class="container">
            <div class="row g-4 pb-4">
                <div class="col-lg-4">
                    <div class="nm-footer-logo mb-2">N<span>.</span>M<span>.</span> Coaching</div>
                    <p class="mt-2 mb-3" style="color:rgba(255,255,255,0.5);font-size:.875rem;line-height:1.7">
                        Founded by <strong style="color:rgba(255,255,255,.8)">Neeraj Sisodiya</strong>,
                        empowering students since 2015 with quality education and expert guidance.
                    </p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="mb-3">Quick Links</h6>
                    <ul class="list-unstyled" style="line-height:2.1">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Home" asp-action="Courses">Courses</a></li>
                        <li><a asp-controller="Home" asp-action="Classes">Classes</a></li>
                        <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="mb-3">Programs</h6>
                    <ul class="list-unstyled" style="line-height:2.1">
                        <li><a href="#">JEE Preparation</a></li>
                        <li><a href="#">NEET Coaching</a></li>
                        <li><a href="#">Board Exams</a></li>
                        <li><a href="#">Foundation</a></li>
                        <li><a href="#">Skill Courses</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="mb-3">Find Us</h6>
                    <div style="font-size:.85rem">
                        <div class="mb-1">📍 123 Education Street, Knowledge Park, City - 123456</div>
                        <div class="mb-1">📞 <a href="tel:+919876543210">+91 98765 43210</a></div>
                        <div class="mb-3">📧 <a href="mailto:info@nmcoaching.com">info@nmcoaching.com</a></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="nm-footer-bottom text-center py-3 mt-2" style="color:rgba(255,255,255,.35)">
            &copy; @DateTime.Now.Year N.M. Coaching Centre · All Rights Reserved
        </div>
    </footer>
}
else
{
    <!-- DASHBOARD TOPBAR -->
    <nav class="nm-navbar navbar">
        <div class="container-fluid px-3 d-flex align-items-center">
            <a class="navbar-brand me-auto" asp-controller="Home" asp-action="Index">
                N<span>.</span>M<span>.</span> Coaching
            </a>
            <div class="d-flex align-items-center gap-2">
                <span class="text-white-50 small d-none d-md-inline">@fullName</span>
                <span class="badge"
                      style="background:#f59e0b;color:#0a1628;font-size:.7rem;font-family:'Sora',sans-serif">
                    @role
                </span>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-light border-0 rounded-circle"
                            data-bs-toggle="dropdown"
                            style="width:36px;height:36px;font-size:1rem">
                        👤
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0"
                        style="border-radius:14px;min-width:180px">
                        @if (role == "Admin")
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Admin" asp-action="Profile">
                                    👤 My Profile
                                </a>
                            </li>
                        }
                        else if (role == "Teacher")
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Teacher" asp-action="Profile">
                                    👤 My Profile
                                </a>
                            </li>
                        }
                        else if (role == "Student")
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Student" asp-action="Profile">
                                    👤 My Profile
                                </a>
                            </li>
                        }
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item text-danger fw-semibold">
                                    🚪 Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- MOBILE NAV BAR (only on phones) -->
    <div class="d-md-none"
         style="background:#0f172a;border-bottom:1px solid rgba(255,255,255,.06);overflow-x:auto">
        <div class="d-flex gap-2 px-3 py-2" style="white-space:nowrap">
            @if (role == "Admin")
            {
                <a class="btn btn-sm @(curAction=="Index"?"btn-primary":"btn-outline-light")"
                   asp-controller="Admin" asp-action="Index"
                   style="border-radius:20px;font-size:.75rem">📊 Dashboard</a>
                <a class="btn btn-sm @(curAction=="Teachers"?"btn-primary":"btn-outline-light")"
                   asp-controller="Admin" asp-action="Teachers"
                   style="border-radius:20px;font-size:.75rem">👩‍🏫 Teachers</a>
                <a class="btn btn-sm @(curAction=="Students"?"btn-primary":"btn-outline-light")"
                   asp-controller="Admin" asp-action="Students"
                   style="border-radius:20px;font-size:.75rem">👨‍🎓 Students</a>
                <a class="btn btn-sm @(curAction=="Courses"?"btn-primary":"btn-outline-light")"
                   asp-controller="Admin" asp-action="Courses"
                   style="border-radius:20px;font-size:.75rem">📚 Courses</a>
                <a class="btn btn-sm @(curAction=="Classes"?"btn-primary":"btn-outline-light")"
                   asp-controller="Admin" asp-action="Classes"
                   style="border-radius:20px;font-size:.75rem">🏫 Classes</a>
                <a class="btn btn-sm @(curAction=="Subjects"?"btn-primary":"btn-outline-light")"
                   asp-controller="Admin" asp-action="Subjects"
                   style="border-radius:20px;font-size:.75rem">📖 Subjects</a>
                <a class="btn btn-sm @(curAction=="AssignTeacher"?"btn-primary":"btn-outline-light")"
                   asp-controller="Admin" asp-action="AssignTeacher"
                   style="border-radius:20px;font-size:.75rem">🔗 Assign</a>
                <a class="btn btn-sm @(curAction=="Announcements"?"btn-primary":"btn-outline-light")"
                   asp-controller="Admin" asp-action="Announcements"
                   style="border-radius:20px;font-size:.75rem">📢 Announce</a>
                <a class="btn btn-sm @(curAction=="Profile"?"btn-primary":"btn-outline-light")"
                   asp-controller="Admin" asp-action="Profile"
                   style="border-radius:20px;font-size:.75rem">👤 Profile</a>
            }
            else if (role == "Teacher")
            {
                <a class="btn btn-sm @(curAction=="Index"?"btn-primary":"btn-outline-light")"
                   asp-controller="Teacher" asp-action="Index"
                   style="border-radius:20px;font-size:.75rem">📊 Dashboard</a>
                <a class="btn btn-sm @(curAction=="Students"?"btn-primary":"btn-outline-light")"
                   asp-controller="Teacher" asp-action="Students"
                   style="border-radius:20px;font-size:.75rem">👨‍🎓 Students</a>
                <a class="btn btn-sm @(curAction=="Marks"?"btn-primary":"btn-outline-light")"
                   asp-controller="Teacher" asp-action="Marks"
                   style="border-radius:20px;font-size:.75rem">📝 Marks</a>
                <a class="btn btn-sm @(curAction=="Profile"?"btn-primary":"btn-outline-light")"
                   asp-controller="Teacher" asp-action="Profile"
                   style="border-radius:20px;font-size:.75rem">👤 Profile</a>
            }
            else if (role == "Student")
            {
                <a class="btn btn-sm @(curAction=="Index"?"btn-primary":"btn-outline-light")"
                   asp-controller="Student" asp-action="Index"
                   style="border-radius:20px;font-size:.75rem">📊 Dashboard</a>
                <a class="btn btn-sm @(curAction=="Marks"?"btn-primary":"btn-outline-light")"
                   asp-controller="Student" asp-action="Marks"
                   style="border-radius:20px;font-size:.75rem">📝 Marks</a>
                <a class="btn btn-sm @(curAction=="Performance"?"btn-primary":"btn-outline-light")"
                   asp-controller="Student" asp-action="Performance"
                   style="border-radius:20px;font-size:.75rem">📈 Performance</a>
                <a class="btn btn-sm @(curAction=="Profile"?"btn-primary":"btn-outline-light")"
                   asp-controller="Student" asp-action="Profile"
                   style="border-radius:20px;font-size:.75rem">👤 Profile</a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-0 rounded-0">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-0 rounded-0">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- DASHBOARD BODY -->
    <div class="container-fluid p-0">
        <div class="row g-0">

            <!-- SIDEBAR (desktop only) -->
            @if (role == "Admin")
            {
                <nav class="col-md-2 d-none d-md-block sidebar">
                    <div class="nav-header">Admin Panel</div>
                    <a class="nav-link @(curAction=="Index"?"active":"")"
                       asp-controller="Admin" asp-action="Index">📊 Dashboard</a>
                    <a class="nav-link @(curAction=="Teachers"?"active":"")"
                       asp-controller="Admin" asp-action="Teachers">👩‍🏫 Teachers</a>
                    <a class="nav-link @(curAction=="Students"?"active":"")"
                       asp-controller="Admin" asp-action="Students">👨‍🎓 Students</a>
                    <a class="nav-link @(curAction=="Courses"?"active":"")"
                       asp-controller="Admin" asp-action="Courses">📚 Courses</a>
                    <a class="nav-link @(curAction=="Classes"?"active":"")"
                       asp-controller="Admin" asp-action="Classes">🏫 Classes</a>
                    <a class="nav-link @(curAction=="Subjects"?"active":"")"
                       asp-controller="Admin" asp-action="Subjects">📖 Subjects</a>
                    <a class="nav-link @(curAction=="AssignTeacher"?"active":"")"
                       asp-controller="Admin" asp-action="AssignTeacher">🔗 Assign Teacher</a>
                    <a class="nav-link @(curAction=="Announcements"?"active":"")"
                       asp-controller="Admin" asp-action="Announcements">📢 Announcements</a>
                    <a class="nav-link @(curAction=="Messages"?"active":"")"
                       asp-controller="Admin" asp-action="Messages">💬 Messages</a>
                    <div style="border-top:1px solid rgba(255,255,255,.07);margin:10px 8px"></div>
                    <a class="nav-link @(curAction=="Profile"?"active":"")"
                       asp-controller="Admin" asp-action="Profile">👤 My Profile</a>
                </nav>
            }
            else if (role == "Teacher")
            {
                <nav class="col-md-2 d-none d-md-block sidebar">
                    <div class="nav-header">Teacher Panel</div>
                    <a class="nav-link @(curAction=="Index"?"active":"")"
                       asp-controller="Teacher" asp-action="Index">📊 Dashboard</a>
                    <a class="nav-link @(curAction=="Students"?"active":"")"
                       asp-controller="Teacher" asp-action="Students">👨‍🎓 Students</a>
                    <a class="nav-link @(curAction=="Marks"?"active":"")"
                       asp-controller="Teacher" asp-action="Marks">📝 Marks</a>
                    <div style="border-top:1px solid rgba(255,255,255,.07);margin:10px 8px"></div>
                    <a class="nav-link @(curAction=="Profile"?"active":"")"
                       asp-controller="Teacher" asp-action="Profile">👤 My Profile</a>
                </nav>
            }
            else if (role == "Student")
            {
                <nav class="col-md-2 d-none d-md-block sidebar">
                    <div class="nav-header">Student Panel</div>
                    <a class="nav-link @(curAction=="Index"?"active":"")"
                       asp-controller="Student" asp-action="Index">📊 Dashboard</a>
                    <a class="nav-link @(curAction=="Marks"?"active":"")"
                       asp-controller="Student" asp-action="Marks">📝 My Marks</a>
                    <a class="nav-link @(curAction=="Performance"?"active":"")"
                       asp-controller="Student" asp-action="Performance">📈 Performance</a>
                    <div style="border-top:1px solid rgba(255,255,255,.07);margin:10px 8px"></div>
                    <a class="nav-link @(curAction=="Profile"?"active":"")"
                       asp-controller="Student" asp-action="Profile">👤 Profile</a>
                </nav>
            }

            <!-- MAIN CONTENT -->
            <main class="@(role != null ? "col-md-10" : "col-12") main-content">
                @RenderBody()
            </main>

        </div>
    </div>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>