@model List<CoachingMVC.ViewModels.Shared.ClassViewModel>
@{
    ViewData["Title"] = "Teacher Dashboard";
    var name = Context.Session.GetString("FullName") ?? "Teacher";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="page-title">
            👋 Welcome Back, @name
        </h2>

        <p class="text-muted">
            Manage your classes, students and marks.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Profile" class="btn btn-sm btn-outline-secondary">👤 Profile</a>
    </div>
</div>

<!-- Modern Stat Cards -->
<div class="row g-4 mb-4">

    <div class="col-md-3">
        <div class="stat-card bg-gradient-blue">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-value">@Model.Count</div>
                    <div class="stat-label">My Classes</div>
                </div>
                <div style="font-size:3rem;opacity:.3">🏫</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card bg-gradient-green">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-value">@ViewBag.TotalStudents</div>
                    <div class="stat-label">Students</div>
                </div>
                <div style="font-size:3rem;opacity:.3">👨‍🎓</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <a asp-action="Marks"
           asp-route-classId="@(Model.FirstOrDefault()?.Id ?? 0)"
           class="text-decoration-none">

            <div class="stat-card bg-gradient-purple">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-value">📝</div>
                        <div class="stat-label">Enter Marks</div>
                    </div>
                    <div style="font-size:3rem;opacity:.3">📋</div>
                </div>
            </div>

        </a>
    </div>

    <div class="col-md-3">
        <a asp-action="Students"
           asp-route-classId="@(Model.FirstOrDefault()?.Id ?? 0)"
           class="text-decoration-none">

            <div class="stat-card bg-gradient-orange">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-value">👥</div>
                        <div class="stat-label">Students</div>
                    </div>
                    <div style="font-size:3rem;opacity:.3">🎓</div>
                </div>
            </div>

        </a>
    </div>

</div>

<div class="row g-3">
    <!-- My Classes -->
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">🏫 My Classes</div>
            <div class="card-body p-0">
                @if (Model.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr><th>Class</th><th>Course</th><th>Schedule</th><th>Students</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var cls in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@cls.Name</td>
                                    <td><span class="badge bg-info text-dark">@cls.CourseName</span></td>
                                    <td class="small">@(cls.Schedule ?? "—") @(cls.Timing != null ? $"· {cls.Timing}" : "")</td>
                                    <td><span class="badge bg-secondary">@cls.EnrolledCount</span></td>
                                    <td>
                                        <a asp-action="Students" asp-route-classId="@cls.Id" class="btn btn-sm btn-outline-primary">Students</a>
                                        <a asp-action="Marks" asp-route-classId="@cls.Id" class="btn btn-sm btn-outline-success">Marks</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">No classes assigned yet. Contact admin.</p>
                }
            </div>
        </div>
    </div>

    <!-- Announcements for Teachers -->
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">📢 Announcements</div>
            <div class="card-body p-0" id="announcementsBox">
                <div class="p-3 text-muted small">Loading...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load announcements via API
        fetch('/Home/GetAnnouncements')
            .then(r => r.json())
            .then(data => {
                const box = document.getElementById('announcementsBox');
                if (!data || data.length === 0) {
                    box.innerHTML = '<p class="text-muted p-3 mb-0 small">No announcements.</p>';
                    return;
                }
                box.innerHTML = data.map(a => `
                    <div class="px-3 py-2 border-bottom">
                        <div class="fw-semibold small">${a.title}</div>
                        <div class="text-muted" style="font-size:12px">${a.content}</div>
                        <div class="text-muted" style="font-size:11px">${new Date(a.createdAt).toLocaleDateString()}</div>
                    </div>`).join('');
            })
            .catch(() => {
                document.getElementById('announcementsBox').innerHTML = '<p class="text-muted p-3 small mb-0">Could not load.</p>';
            });
    </script>
}
