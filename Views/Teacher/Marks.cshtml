@model List<CoachingMVC.ViewModels.Student.MarkViewModel>
@using CoachingMVC.ViewModels.Shared
@using CoachingMVC.ViewModels.Student
@{
    ViewData["Title"] = "Marks Management";
    var classes         = ViewBag.Classes as List<ClassViewModel> ?? new();
    var students        = ViewBag.Students as List<StudentViewModel> ?? new();
    var subjects        = ViewBag.Subjects as List<SubjectViewModel> ?? new();
    var selectedClassId = (int)(ViewBag.SelectedClassId ?? 0);
    var examType        = ViewBag.ExamType?.ToString() ?? "All";
    var examTypes       = new[] { "Test", "Midterm", "Final", "Assignment", "Quiz" };
    var grouped         = Model.GroupBy(m => m.ExamType).OrderBy(g => g.Key).ToList();
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">📝 Marks Management</h4>
        <p class="text-muted small mb-0">Record and manage student marks</p>
    </div>
    @if (selectedClassId > 0)
    {
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addMarkModal">
            ➕ Add Mark
        </button>
    }
</div>

<!-- Class Tabs (scrollable on mobile) -->
@if (classes.Any())
{
    <div style="overflow-x:auto;white-space:nowrap;padding-bottom:4px" class="mb-3">
        <ul class="nav nav-tabs flex-nowrap" style="display:inline-flex;min-width:100%">
            @foreach (var c in classes)
            {
                <li class="nav-item">
                    <a class="nav-link @(c.Id == selectedClassId ? "active fw-semibold" : "")"
                       asp-action="Marks" asp-route-classId="@c.Id" asp-route-examType="All">
                        🏫 @c.Name
                    </a>
                </li>
            }
        </ul>
    </div>
}

@if (selectedClassId > 0)
{
    <!-- Exam Type Filter -->
    <div class="card mb-3">
        <div class="card-body py-2 px-3">
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <a asp-action="Marks" asp-route-classId="@selectedClassId" asp-route-examType="All"
                   class="btn btn-sm @(examType=="All"?"btn-dark":"btn-outline-secondary")">
                    All
                    <span class="badge @(examType=="All"?"bg-light text-dark":"bg-secondary") ms-1">
                        @Model.Count
                    </span>
                </a>
                @foreach (var et in examTypes)
                {
                    var count = Model.Count(m => m.ExamType == et);
                    <a asp-action="Marks" asp-route-classId="@selectedClassId" asp-route-examType="@et"
                       class="btn btn-sm @(et==examType?"btn-primary":"btn-outline-secondary")">
                        @et
                        @if (count > 0)
                        {
                            <span class="badge @(et==examType?"bg-light text-dark":"bg-primary") ms-1">
                                @count
                            </span>
                        }
                    </a>
                }
            </div>
        </div>
    </div>

    @if (examType == "All" && grouped.Any())
    {
        @foreach (var group in grouped)
        {
            var avg = group.Average(m => m.Percentage);
            var avgColor = avg >= 75 ? "success" : avg >= 50 ? "warning" : "danger";
            var examIcon = group.Key switch {
                "Midterm"    => "📋",
                "Final"      => "🎯",
                "Test"       => "✏️",
                "Assignment" => "📄",
                "Quiz"       => "⚡",
                _            => "📝"
            };

            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <h6 class="fw-bold mb-0">@examIcon @group.Key</h6>
                    <span class="badge bg-secondary rounded-pill">@group.Count() marks</span>
                    <span class="badge bg-@avgColor rounded-pill">Avg: @avg.ToString("F1")%</span>
                </div>

                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Student</th>
                                        <th>Subject</th>
                                        <th>Marks</th>
                                        <th>Max</th>
                                        <th>%</th>
                                        <th>Grade</th>
                                        <th>Date</th>
                                        <th>Remarks</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in group.OrderBy(m => m.StudentName))
                                    {
                                        var bc = m.Grade switch {
                                            "A+" or "A" => "success",
                                            "B+" or "B" => "primary",
                                            "C"         => "warning",
                                            _           => "danger"
                                        };
                                        <tr>
                                            <td class="fw-bold">@m.StudentName</td>
                                            <td class="small">@m.SubjectName</td>
                                            <td class="fw-semibold">@m.ObtainedMarks</td>
                                            <td class="text-muted small">@m.MaxMarks</td>
                                            <td style="min-width:120px">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height:6px">
                                                        <div class="progress-bar bg-@bc"
                                                             style="width:@((int)m.Percentage)%"></div>
                                                    </div>
                                                    <span class="small">@m.Percentage.ToString("F1")%</span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge rounded-pill bg-@bc">@m.Grade</span>
                                            </td>
                                            <td class="small text-muted">@m.ExamDate.ToString("dd MMM yyyy")</td>
                                            <td class="small text-muted">@(m.Remarks ?? "—")</td>
                                            <td>
                                                <form asp-action="DeleteMark" method="post"
                                                      onsubmit="return confirm('Delete this mark?')">
                                                    <input type="hidden" name="id" value="@m.Id" />
                                                    <input type="hidden" name="classId" value="@selectedClassId" />
                                                    <input type="hidden" name="examType" value="All" />
                                                    <button class="btn btn-sm btn-outline-danger">🗑</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Subject</th>
                                <th>Marks</th>
                                <th>Max</th>
                                <th>%</th>
                                <th>Grade</th>
                                <th>Date</th>
                                <th>Remarks</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Any())
                            {
                                foreach (var m in Model.OrderBy(m => m.StudentName))
                                {
                                    var bc = m.Grade switch {
                                        "A+" or "A" => "success",
                                        "B+" or "B" => "primary",
                                        "C"         => "warning",
                                        _           => "danger"
                                    };
                                    <tr>
                                        <td class="fw-bold">@m.StudentName</td>
                                        <td class="small">@m.SubjectName</td>
                                        <td class="fw-semibold">@m.ObtainedMarks</td>
                                        <td class="text-muted small">@m.MaxMarks</td>
                                        <td style="min-width:120px">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" style="height:6px">
                                                    <div class="progress-bar bg-@bc"
                                                         style="width:@((int)m.Percentage)%"></div>
                                                </div>
                                                <span class="small">@m.Percentage.ToString("F1")%</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill bg-@bc">@m.Grade</span>
                                        </td>
                                        <td class="small text-muted">@m.ExamDate.ToString("dd MMM yyyy")</td>
                                        <td class="small text-muted">@(m.Remarks ?? "—")</td>
                                        <td>
                                            <form asp-action="DeleteMark" method="post"
                                                  onsubmit="return confirm('Delete this mark?')">
                                                <input type="hidden" name="id" value="@m.Id" />
                                                <input type="hidden" name="classId" value="@selectedClassId" />
                                                <input type="hidden" name="examType" value="@examType" />
                                                <button class="btn btn-sm btn-outline-danger">🗑</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9">
                                        <div class="empty-state">
                                            <div class="empty-icon">📝</div>
                                            <div class="fw-semibold">No marks recorded for @examType</div>
                                            <div class="small">Add marks using the button above</div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="empty-state">
                <div class="empty-icon">🏫</div>
                <div class="fw-semibold">Select a class to view marks</div>
                <div class="small">Choose a class from the tabs above</div>
            </div>
        </div>
    </div>
}

<!-- ADD MARK MODAL -->
<div class="modal fade" id="addMarkModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:18px;overflow:hidden;border:none">
            <div class="modal-header text-white"
                 style="background:linear-gradient(135deg,#10b981,#059669)">
                <h5 class="modal-title fw-bold">📝 Add Mark</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddMark" method="post">
                <input type="hidden" name="classId" value="@selectedClassId" />
                <div class="modal-body row g-3 p-4">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Student *</label>
                        <select name="studentId" class="form-select" required>
                            <option value="">Select student</option>
                            @foreach (var s in students)
                            {
                                <option value="@s.Id">
                                    @s.FullName (@(s.RollNumber ?? s.Email))
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Subject *</label>
                        <select name="subjectId" class="form-select" required>
                            <option value="">Select subject</option>
                            @foreach (var s in subjects)
                            {
                                <option value="@s.Id">@s.Name (Max: @s.MaxMarks)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Obtained Marks *</label>
                        <input name="obtainedMarks" type="number" step="0.5"
                               class="form-control" min="0" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Exam Type *</label>
                        <select name="examType" class="form-select">
                            @foreach (var et in examTypes)
                            {
                                <option value="@et"
                                        selected="@(et == (examType == "All" ? "Test" : examType))">
                                    @et
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Exam Date *</label>
                        <input name="examDate" type="date" class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Remarks</label>
                        <input name="remarks" class="form-control" placeholder="Optional" />
                    </div>
                </div>
                <div class="modal-footer px-4 pb-4" style="border-top:1px solid #eef2f7">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success px-4">✅ Save Mark</button>
                </div>
            </form>
        </div>
    </div>
</div>