@model CoachingMVC.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Header -->
<div class="d-flex align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0f172a">📊 Admin Dashboard</h4>
        <p class="text-muted small mb-0 mt-1">Welcome back. Here's what's happening today.</p>
    </div>
</div>

<!-- Stats Grid -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:16px;overflow:hidden;border-left:5px solid #2563eb !important">
            <div class="card-body d-flex justify-content-between align-items-center py-3 px-3">
                <div>
                    <div class="fs-2 fw-bold text-primary">@Model.TotalStudents</div>
                    <div class="small text-muted fw-semibold">Students</div>
                </div>
                <span style="font-size:2.2rem;opacity:0.7">👨‍🎓</span>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:16px;overflow:hidden;border-left:5px solid #10b981 !important">
            <div class="card-body d-flex justify-content-between align-items-center py-3 px-3">
                <div>
                    <div class="fs-2 fw-bold text-success">@Model.TotalTeachers</div>
                    <div class="small text-muted fw-semibold">Teachers</div>
                </div>
                <span style="font-size:2.2rem;opacity:0.7">👩‍🏫</span>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:16px;overflow:hidden;border-left:5px solid #8b5cf6 !important">
            <div class="card-body d-flex justify-content-between align-items-center py-3 px-3">
                <div>
                    <div class="fs-2 fw-bold" style="color:#8b5cf6">@Model.TotalCourses</div>
                    <div class="small text-muted fw-semibold">Courses</div>
                </div>
                <span style="font-size:2.2rem;opacity:0.7">📚</span>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:16px;overflow:hidden;border-left:5px solid #f59e0b !important">
            <div class="card-body d-flex justify-content-between align-items-center py-3 px-3">
                <div>
                    <div class="fs-2 fw-bold text-warning">@Model.TotalClasses</div>
                    <div class="small text-muted fw-semibold">Classes</div>
                </div>
                <span style="font-size:2.2rem;opacity:0.7">🏫</span>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.PendingAdmissions != null && (int)ViewBag.PendingAdmissions > 0)
{
    <div class="alert alert-warning d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3" style="border-radius:12px;border:none;background:#fef3c7">
        <strong>📋 @ViewBag.PendingAdmissions new admission(s) pending!</strong>
        <a asp-controller="Admission" asp-action="Index" asp-route-status="Pending" class="btn btn-warning btn-sm rounded-pill fw-semibold px-3">Review →</a>
    </div>
}

@if (ViewBag.UnreadMessages != null && (int)ViewBag.UnreadMessages > 0)
{
    <div class="alert alert-info d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3" style="border-radius:12px;border:none;background:#e0f2fe;color:#0369a1">
        <strong>💬 @ViewBag.UnreadMessages unread messages</strong>
        <a asp-controller="Admin" asp-action="Messages" class="btn btn-info btn-sm text-white rounded-pill fw-semibold px-3 border-0">View →</a>
    </div>
}

<div class="row g-3">
    <!-- Announcements -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100 border-0" style="border-radius:16px;overflow:hidden">
            <div class="card-header bg-white d-flex justify-content-between align-items-center" style="border-bottom:1px solid #f1f5f9;padding:1rem 1.25rem;border-radius:16px 16px 0 0">
                <span class="fw-bold fs-6">📢 Recent Announcements</span>
                <a asp-action="Announcements" class="btn btn-sm btn-outline-primary rounded-pill" style="font-size:.75rem">Manage</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentAnnouncements.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var a in Model.RecentAnnouncements)
                        {
                            <li class="list-group-item px-3 py-2 border-light" style="font-size:.88rem">
                                <div class="fw-semibold">@a.Title</div>
                                <div class="text-muted small truncate">@a.Content</div>
                                <div class="text-muted mt-1" style="font-size:.72rem">@a.CreatedAt.ToString("dd MMM yyyy")</div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted p-3 mb-0 small text-center">No announcements yet.</p>
                }
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100 border-0" style="border-radius:16px;overflow:hidden">
            <div class="card-header bg-white fw-bold" style="border-bottom:1px solid #f1f5f9;padding:1rem 1.25rem;border-radius:16px 16px 0 0">
                ⚡ Quick Actions
            </div>
            <div class="card-body p-3">
                <div class="d-grid gap-2">
                    <a asp-action="Teachers" class="btn btn-outline-success btn-sm text-start rounded-pill" style="padding:.55rem 1.1rem;font-weight:600">➕ Add New Teacher</a>
                    <a asp-action="Courses" class="btn btn-outline-primary btn-sm text-start rounded-pill" style="padding:.55rem 1.1rem;font-weight:600">➕ Add New Course</a>
                    <a asp-action="Classes" class="btn btn-outline-warning btn-sm text-start rounded-pill" style="padding:.55rem 1.1rem;font-weight:600">➕ Create Class</a>
                    <a asp-action="AssignTeacher" class="btn btn-outline-info btn-sm text-start rounded-pill" style="padding:.55rem 1.1rem;font-weight:600">🔗 Assign Teacher</a>
                    <a asp-action="Announcements" class="btn btn-outline-secondary btn-sm text-start rounded-pill" style="padding:.55rem 1.1rem;font-weight:600">📢 Post Announcement</a>
                </div>
            </div>
        </div>
    </div>
</div>