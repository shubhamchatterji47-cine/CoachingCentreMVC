@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="main-content">
    <h2 class="page-title">Admin Dashboard</h2>
    <p class="text-muted mb-4">Welcome back. Here's what's happening today.</p>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="stat-card bg-gradient-blue">
                <div class="stat-value">@ViewBag.StudentCount</div>
                <div class="stat-label">Students</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card bg-gradient-green">
                <div class="stat-value">@ViewBag.TeacherCount</div>
                <div class="stat-label">Teachers</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card bg-gradient-purple">
                <div class="stat-value">@ViewBag.CourseCount</div>
                <div class="stat-label">Courses</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card bg-gradient-orange">
                <div class="stat-value">@ViewBag.ClassCount</div>
                <div class="stat-label">Classes</div>
            </div>
        </div>
    </div>

    <!-- Quick Links / Action Cards -->
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card modern-card">
                <div class="card-body">
                    <h5 class="mb-3">📄 Applications</h5>
                    <p class="text-muted">You have <strong>@ViewBag.ApplicationCount</strong> new applications.</p>
                    <a href="/Admin/Applications" class="btn btn-primary">View Applications</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card modern-card">
                <div class="card-body">
                    <h5 class="mb-3">💬 Messages</h5>
                    <p class="text-muted">You have <strong>@ViewBag.MessageCount</strong> messages.</p>
                    <a href="/Admin/Messages" class="btn btn-primary">View Messages</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card modern-card">
                <div class="card-body">
                    <h5 class="mb-3">📢 Announcements</h5>
                    <p class="text-muted">Manage announcements.</p>
                    <a href="/Admin/Announcements" class="btn btn-primary">View Announcements</a>
                </div>
            </div>
        </div>
    </div>
</div>