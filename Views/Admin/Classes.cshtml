@model List<CoachingMVC.ViewModels.Shared.ClassViewModel>
@using CoachingMVC.ViewModels.Shared
@{
    ViewData["Title"] = "Classes";
    var courses = ViewBag.Courses as List<CourseViewModel> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">🏫 Classes</h4>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addClassModal">➕ Add Class</button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="row g-3">
    @foreach (var c in Model)
    {
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="fw-bold">@c.Name</h6>
                    <span class="badge bg-info text-dark mb-2">@c.CourseName</span>
                    <p class="small text-muted">@(c.Description ?? "")</p>
                    <div class="d-flex gap-2 flex-wrap small">
                        @if (!string.IsNullOrEmpty(c.Schedule))
                        {
                            <span class="badge bg-light text-dark">📅 @c.Schedule</span>
                        }
                        @if (!string.IsNullOrEmpty(c.Timing))
                        {
                            <span class="badge bg-light text-dark">🕐 @c.Timing</span>
                        }
                        <span class="badge bg-light text-dark">👥 @c.EnrolledCount / @c.MaxCapacity</span>
                    </div>
                    <div class="mt-2 small text-muted">Started: @c.StartDate.ToString("dd MMM yyyy")</div>
                </div>
                <div class="card-footer bg-transparent d-flex gap-2">
                    <a asp-controller="Admin" asp-action="Students" asp-route-classId="@c.Id"
                       class="btn btn-sm btn-outline-primary flex-fill">👥 Students</a>
                    <button class="btn btn-sm btn-outline-warning"
                            onclick="openEditClass(@c.Id,
                                    '@Html.Raw(c.Name.Replace("'", "\\\'"))',
                                    '@Html.Raw((c.Description ?? "").Replace("'", "\\\'"))',
                                    @c.CourseId,
                                    '@Html.Raw((c.Schedule ?? "").Replace("'", "\\\'"))',
                                    '@Html.Raw((c.Timing ?? "").Replace("'", "\\\'"))',
                                    @c.MaxCapacity,
                                    '@c.StartDate.ToString("yyyy-MM-dd")',
                                    '@(c.EndDate.HasValue? c.EndDate.Value.ToString("yyyy-MM-dd") : "")')">
                        ✏️
                    </button>
                    <form asp-action="DeleteClass" method="post"
                          onsubmit="return confirm('Delete \'@c.Name\'? Only possible if no students enrolled.')">
                        <input type="hidden" name="id" value="@c.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">🗑</button>
                    </form>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12"><p class="text-muted text-center py-4">No classes found.</p></div>
    }
</div>

<!-- ── ADD CLASS MODAL ──────────────────────────────────────────── -->
<div class="modal fade" id="addClassModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Class</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateClass" method="post">
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Class Name *</label>
                        <input name="name" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Course *</label>
                        <select name="courseId" class="form-select" required>
                            <option value="">Select course</option>
                            @foreach (var c in courses)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Schedule</label>
                        <input name="schedule" class="form-control" placeholder="e.g. Mon/Wed/Fri" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Timing</label>
                        <input name="timing" class="form-control" placeholder="e.g. 9:00 AM - 11:00 AM" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Max Capacity *</label>
                        <input name="maxCapacity" type="number" class="form-control" value="30" min="1" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Start Date *</label>
                        <input name="startDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">End Date</label>
                        <input name="endDate" type="date" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Class</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── EDIT CLASS MODAL ─────────────────────────────────────────── -->
<div class="modal fade" id="editClassModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">✏️ Edit Class</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateClass" method="post">
                <input type="hidden" name="id" id="editClassId" />
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Class Name *</label>
                        <input name="name" id="editClassName" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Course *</label>
                        <select name="courseId" id="editClassCourse" class="form-select" required>
                            @foreach (var c in courses)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea name="description" id="editClassDesc" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Schedule</label>
                        <input name="schedule" id="editClassSchedule" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Timing</label>
                        <input name="timing" id="editClassTiming" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Max Capacity *</label>
                        <input name="maxCapacity" id="editClassCap" type="number" class="form-control" min="1" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Start Date *</label>
                        <input name="startDate" id="editClassStart" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">End Date</label>
                        <input name="endDate" id="editClassEnd" type="date" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditClass(id, name, desc, courseId, schedule, timing, maxCap, startDate, endDate) {
            document.getElementById('editClassId').value       = id;
            document.getElementById('editClassName').value     = name;
            document.getElementById('editClassDesc').value     = desc;
            document.getElementById('editClassCourse').value   = courseId;
            document.getElementById('editClassSchedule').value = schedule;
            document.getElementById('editClassTiming').value   = timing;
            document.getElementById('editClassCap').value      = maxCap;
            document.getElementById('editClassStart').value    = startDate;
            document.getElementById('editClassEnd').value      = endDate;
            new bootstrap.Modal(document.getElementById('editClassModal')).show();
        }
    </script>
}
