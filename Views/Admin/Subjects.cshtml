@model List<CoachingMVC.ViewModels.Shared.SubjectViewModel>
@using CoachingMVC.ViewModels.Shared
@{
    ViewData["Title"] = "Subjects";
    var courses = ViewBag.Courses as List<CourseViewModel> ?? new();
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">📖 Subjects</h4>
        <p class="text-muted small mb-0">Manage subjects for each course</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addSubjectModal">
        ➕ Add Subject
    </button>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>All Subjects</span>
        <span class="badge bg-primary rounded-pill">@Model.Count Total</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Subject Name</th>
                        <th>Course</th>
                        <th>Max Marks</th>
                        <th>Passing Marks</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        int i = 1;
                        foreach (var s in Model)
                        {
                            <tr>
                                <td class="text-muted">@i</td>
                                <td class="fw-bold">@s.Name</td>
                                <td>
                                    <span class="badge rounded-pill"
                                          style="background:#e0f2fe;color:#0369a1;font-size:.78rem">
                                        @s.CourseName
                                    </span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-light text-dark border">
                                        @s.MaxMarks
                                    </span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-light text-dark border">
                                        @s.PassingMarks
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <button class="btn btn-sm btn-outline-warning"
                                                onclick="openEditSubject(
                                                    @s.Id,
                                                    '@Html.Raw(s.Name.Replace("'","\\\'"))',
                                                    '@Html.Raw((s.Description??"").Replace("'","\\\'"))',
                                                    @s.CourseId,
                                                    @s.MaxMarks,
                                                    @s.PassingMarks)">
                                            ✏️ Edit
                                        </button>
                                        <form asp-action="DeleteSubject" method="post"
                                              onsubmit="return confirm('Delete \'@s.Name\'?')">
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">🗑</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <div class="empty-icon">📖</div>
                                    <div class="fw-semibold">No subjects yet</div>
                                    <div class="small">Add subjects for each course</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ADD SUBJECT MODAL -->
<div class="modal fade" id="addSubjectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:18px;overflow:hidden;border:none">
            <div class="modal-header text-white"
                 style="background:linear-gradient(135deg,#2563eb,#1e40af)">
                <h5 class="modal-title fw-bold">📖 Add New Subject</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateSubject" method="post">
                <div class="modal-body row g-3 p-4">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Subject Name *</label>
                        <input name="name" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Course *</label>
                        <select name="courseId" class="form-select" required>
                            <option value="">Select course</option>
                            @foreach (var c in courses)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Max Marks *</label>
                        <input name="maxMarks" type="number" class="form-control" value="100" min="1" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Passing Marks *</label>
                        <input name="passingMarks" type="number" class="form-control" value="35" min="1" required />
                    </div>
                </div>
                <div class="modal-footer px-4 pb-4" style="border-top:1px solid #eef2f7">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">✅ Add Subject</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT SUBJECT MODAL -->
<div class="modal fade" id="editSubjectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:18px;overflow:hidden;border:none">
            <div class="modal-header text-white"
                 style="background:linear-gradient(135deg,#f59e0b,#ea580c)">
                <h5 class="modal-title fw-bold">✏️ Edit Subject</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateSubject" method="post">
                <input type="hidden" name="id" id="editSubjectId" />
                <div class="modal-body row g-3 p-4">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Subject Name *</label>
                        <input name="name" id="editSubjectName" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="description" id="editSubjectDesc" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Course *</label>
                        <select name="courseId" id="editSubjectCourse" class="form-select" required>
                            @foreach (var c in courses)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Max Marks *</label>
                        <input name="maxMarks" id="editSubjectMax" type="number" class="form-control" min="1" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Passing Marks *</label>
                        <input name="passingMarks" id="editSubjectPass" type="number" class="form-control" min="1" required />
                    </div>
                </div>
                <div class="modal-footer px-4 pb-4" style="border-top:1px solid #eef2f7">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning px-4">💾 Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditSubject(id, name, desc, courseId, maxMarks, passingMarks) {
            document.getElementById('editSubjectId').value     = id;
            document.getElementById('editSubjectName').value   = name;
            document.getElementById('editSubjectDesc').value   = desc;
            document.getElementById('editSubjectCourse').value = courseId;
            document.getElementById('editSubjectMax').value    = maxMarks;
            document.getElementById('editSubjectPass').value   = passingMarks;
            new bootstrap.Modal(document.getElementById('editSubjectModal')).show();
        }
    </script>
}