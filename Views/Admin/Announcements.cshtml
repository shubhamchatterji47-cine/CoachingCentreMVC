@model List<CoachingMVC.ViewModels.Admin.AnnouncementViewModel>
@{
    ViewData["Title"] = "Announcements";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">
            📢 Announcements
            <span class="badge bg-primary ms-2 rounded-pill">@Model.Count</span>
        </h4>
        <p class="text-muted small mb-0">Manage notices and updates for students and teachers</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
        ➕ Post Announcement
    </button>
</div>

@if (Model.Any())
{
    <div class="row g-3">
        @foreach (var a in Model)
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center"
                         style="background:linear-gradient(135deg,#2563eb,#1e40af) !important;color:white !important;border-radius:18px 18px 0 0 !important">
                        <span class="fw-bold" style="font-size:.95rem">@a.Title</span>
                        <span class="badge rounded-pill"
                              style="background:rgba(255,255,255,.2);color:white;font-size:.72rem">
                            @(string.IsNullOrEmpty(a.TargetRole) ? "All Users" : a.TargetRole)
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="text-muted mb-0" style="line-height:1.6;font-size:.9rem">
                            @a.Content
                        </p>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            🕐 @a.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                        </small>
                        <form asp-action="DeleteAnnouncement" method="post"
                              onsubmit="return confirm('Delete this announcement?')">
                            <input type="hidden" name="id" value="@a.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                🗑 Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="empty-state">
                <div class="empty-icon">📢</div>
                <div class="fw-semibold fs-5">No Announcements Yet</div>
                <div class="small mb-3">
                    Post your first announcement to notify students and teachers.
                </div>
                <button class="btn btn-primary"
                        data-bs-toggle="modal" data-bs-target="#addModal">
                    ➕ Create First Announcement
                </button>
            </div>
        </div>
    </div>
}

<!-- ADD ANNOUNCEMENT MODAL -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:18px;overflow:hidden;border:none">
            <div class="modal-header text-white"
                 style="background:linear-gradient(135deg,#2563eb,#1e40af)">
                <h5 class="modal-title fw-bold">📢 Post Announcement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateAnnouncement" method="post">
                <div class="modal-body row g-3 p-4">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Title *</label>
                        <input name="title" class="form-control" required maxlength="200"
                               placeholder="Enter announcement title" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Content *</label>
                        <textarea name="content" class="form-control" rows="4"
                                  required maxlength="1000"
                                  placeholder="Write your announcement here..."></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Target Audience</label>
                        <select name="targetRole" class="form-select">
                            <option value="">👥 All Users</option>
                            <option value="Student">🎓 Students Only</option>
                            <option value="Teacher">👩‍🏫 Teachers Only</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer px-4 pb-4" style="border-top:1px solid #eef2f7">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">📢 Post Announcement</button>
                </div>
            </form>
        </div>
    </div>
</div>